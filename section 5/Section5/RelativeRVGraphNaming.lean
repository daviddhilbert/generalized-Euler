module

public import Section5.RelativeLabelSchemes
public import Section5.RelativeTaggedIsomorphisms

/-! Name the graph of a definable isomorphism over the substructure
generated by a tuple, and retain a first-order validity witness. -/

public section

noncomputable section

namespace GeneralizedEuler.Section5

open GeneralizedEuler.Section2 GeneralizedEuler.Section4 FirstOrder

universe z

variable {L : Language} {E : Type*} {X : TCsort → Type z}
  {M : SortedStructure L E X} {S : SortedSubstructure M} {P : TCsort → Type} {m n : ℕ}

theorem relative_bijection_scheme_of_rv_equiv
    (p : SortedAssignment X P)
    {C : Set (SortedAssignment X (SumVariables P (RVVariables (Fin m))))}
    {D : Set (SortedAssignment X (SumVariables P (RVVariables (Fin n))))}
    {U : Set (Fin m → X .rv)} {V : Set (Fin n → X .rv)}
    (source : ∀ u : SortedAssignment X (RVVariables (Fin m)), appendAssignments p u ∈ C ↔ u .rv ∈ U)
    (target : ∀ v : SortedAssignment X (RVVariables (Fin n)), appendAssignments p v ∈ D ↔ v .rv ∈ V)
    (iso : RVDefinablyEquivalent M (M.termGenerated (namedTuple S p)).carrier U V) :
    ∃ G : Set (SortedAssignment X
        (SumVariables (SumVariables P (RVVariables (Fin m))) (RVVariables (Fin n)))),
      SortedDefinableOver M S.carrier G ∧ FiberBijectionScheme C D G p := by
  obtain ⟨e,he⟩ := iso
  obtain ⟨G,defG,matchG⟩ := definable_relation_fiber_as_scheme p _ (ObjectLift.relation_of_rvGraph he)
  refine ⟨G,defG,?_⟩
  have lift : ∀ {j : ℕ} (a : SortedAssignment X (RVVariables (Fin j))), rvTupleAssignment (a .rv) = a := by
    intro j a
    funext s i
    cases s
    · exact i.elim
    · rfl
  rw [FiberBijectionScheme]
  simp only [matchG,source,target]
  refine ⟨?_,?_,?_,?_⟩
  · intro u
    constructor
    · intro hu
      exact ⟨rvTupleAssignment (e ⟨u .rv,hu⟩).val,⟨u .rv,hu⟩,rfl,rfl⟩
    · rintro ⟨v,x,hx,_⟩
      exact hx ▸ x.property
  · intro v
    constructor
    · intro hv
      let x := e.symm ⟨v .rv,hv⟩
      exact ⟨rvTupleAssignment x.val,x,rfl,congrArg Subtype.val (e.apply_symm_apply _)⟩
    · rintro ⟨u,x,_,hx⟩
      exact hx ▸ (e x).property
  · rintro u v w ⟨x,hx,hy⟩ ⟨x',hx',hz⟩
    have eq : x = x' := Subtype.ext (hx.trans hx'.symm)
    rw [← lift v,← lift w,← hy,← hz,eq]
  · rintro v u w ⟨x,hx,hy⟩ ⟨x',hx',hz⟩
    have eq : x = x' := e.injective (Subtype.ext (hy.trans hz.symm))
    rw [← lift u,← lift w,← hx,← hx',eq]

end GeneralizedEuler.Section5
