module

public import Section5.FieldRVFiberNames
public import Section5.ProjectedRelativeObjects
public import Section5.RelativeObjectDescent
import all Section4.Objects

/-! The RV fibers of a retained-field family have uniform named rows,
one per zero support. Their realized classes are the actual graded
classes over the base generated by the field tuple. -/

public section

noncomputable section

namespace GeneralizedEuler.Section5

open GeneralizedEuler.Section2 GeneralizedEuler.Section4 FirstOrder RelativeObjectFamily

universe z

variable {K : Type z} [Field K] {O : ValuationSubring K}
  {L : Language} {E : Type*}
  {M : SortedStructure L E (CanonicalSort O)} {S : SortedSubstructure M}
  {n k a : ℕ}

namespace RetainedFieldFamily

variable (A : RetainedFieldFamily M S n k) (idx : Fin a ≃ A.tags) (zero : S.carrier .rv)

local notation "Z" => CanonicalSort O
local notation "P" => MixedVariables n Empty
local notation "U" => RVVariables (Fin a)
local notation "Supp" => Finset (Fin k)

@[expose] def supportEnumeration (s : Supp) : Fin (Fintype.card {i // i ∈ s}) → Fin k :=
  Subtype.val ∘ (Fintype.equivFin {i // i ∈ s}).symm

theorem range_supportEnumeration (s : Supp) : Set.range (supportEnumeration s) = (s : Set (Fin k)) := by
  let e := (Fintype.equivFin {i // i ∈ s}).symm
  ext i
  constructor
  · rintro ⟨j,rfl⟩
    exact (e j).property
  · intro hi
    exact ⟨e.symm ⟨i,hi⟩,congrArg Subtype.val (e.apply_symm_apply _)⟩

@[expose] def fieldFiberSupportTags (s : Supp) : Set (SortedAssignment Z (SumVariables P U)) :=
  A.fieldFiberTags idx ∩ {r | r .rv ∘ Sum.inr ∈
    headStartStratum (idx.symm ∘ A.select) (supportEnumeration s) zero.val Set.univ}

theorem fieldFiberSupportTags_definable (s : Supp) :
    SortedDefinableOver M S.carrier (A.fieldFiberSupportTags idx zero s) :=
  (A.fieldFiberTags_definable idx).inter ((headStartStratum_definable (idx.symm ∘ A.select)
    (supportEnumeration s) zero all_rv_tuples_definable).pullback_relabel (fun _ => Sum.inr))

theorem fieldFiberSupportTags_mem (s : Supp) (p : SortedAssignment Z P) (u : SortedAssignment Z U) :
    appendAssignments p u ∈ A.fieldFiberSupportTags idx zero s ↔
      appendAssignments p u ∈ A.fieldFiberTags idx ∧ ∀ i, u .rv (idx.symm (A.select i)) ≠ zero.val ↔ i ∈ s := by
  change (_ ∧ True ∧ ∀ i, u .rv (idx.symm (A.select i)) ≠ zero.val ↔ i ∈ Set.range (supportEnumeration s)) ↔ _
  simp only [true_and,range_supportEnumeration,Finset.mem_coe]

@[expose] def fieldFiberRow (s : Supp) (bound : ℕ) : RelativeRVObjectScheme M S P :=
  RelativeRVObjectScheme.ofProjection (A.fieldFiberSupportTags_definable idx zero s)
    (idx.symm ∘ A.select ∘ supportEnumeration s) bound

theorem fieldFiberRow_exists_bound (s : Supp)
    (sat : let V := SumVariables P (RVVariables (Fin (Fintype.card {i // i ∈ s})))
      RealizesFinitelySatisfiableTypes M (WithBase S.carrier V) (BaseAssignments S.carrier V)) :
    ∃ b, ∀ p, (A.fieldFiberRow idx zero s b).valid zero p := by
  let keep := supportEnumeration s
  let sel := idx.symm ∘ A.select
  have nz (p : SortedAssignment Z P) (u : SortedAssignment Z U)
      (h : appendAssignments p u ∈ A.fieldFiberSupportTags idx zero s) (i : Fin (Fintype.card {j // j ∈ s})) :
      u .rv (sel (keep i)) ≠ zero.val :=
    headStartStratum_nonzero sel keep h.2 i
  apply relative_projection_scheme_valid (A.fieldFiberSupportTags_definable idx zero s) (sel ∘ keep) zero nz _ sat
  intro p y
  let B := A.atFieldTuple p
  have same : sel = B.terminalSelect idx := rfl
  have fin := headStartStratum_finite_indices sel keep zero.val (B.terminalLabels idx)
    (fun v => same ▸ B.terminalLabels_finite idx v) (y .rv)
  have inj : Function.Injective (fun u : SortedAssignment Z U => u .rv) := by
    intro x y eq
    funext s i
    cases s
    · exact i.elim
    · exact congrFun eq i
  apply (fin.preimage inj.injOn).subset
  rintro u ⟨mem,eq⟩
  exact ⟨⟨mem.1,mem.2.2⟩,eq.symm⟩

theorem fieldFiberRows_exists_bounds
    (sat : ∀ d, let V := SumVariables P (RVVariables (Fin d))
      RealizesFinitelySatisfiableTypes M (WithBase S.carrier V) (BaseAssignments S.carrier V)) :
    ∃ bounds : Supp → ℕ, ∀ s p, (A.fieldFiberRow idx zero s (bounds s)).valid zero p := by
  choose b hb using fun s : Supp => A.fieldFiberRow_exists_bound idx zero s (sat (Fintype.card {i // i ∈ s}))
  exact ⟨b,hb⟩

theorem fieldFiberRow_class (p : SortedAssignment Z P)
    (hz : zero.val = M.funMap .rvZero (fun i => i.elim0)) (s : Supp) (b : ℕ)
    (v : (A.fieldFiberRow idx zero s b).valid zero p) :
    let T := M.termGenerated (namedTuple S p)
    let z := M.termGeneratedAssignment (namedTuple S p) .rv (.inl zero)
    let W := A.fieldFiberRow idx zero s b
    objectClass M T ⟨W.data.degree,W.realize zero hz p v⟩ =
      objectClass M T ((A.atFieldTuple p).terminalGradedPiece idx s z hz) := by
  intro T z W
  let D := W.realize zero hz p v
  let B := (A.atFieldTuple p).terminalGradedPiece idx s z hz
  apply scissors_sound M T
  apply RVRelation.iso
  have eq : D.carrier = B.2.carrier := by
    ext u
    exact (A.fieldFiberSupportTags_mem idx zero s p (rvTupleAssignment u)).trans
      ((A.atFieldTuple p).terminalGradedPiece_mem idx s z hz u).symm
  change RVDefinablyEquivalent M T.carrier D.carrier B.2.carrier
  rw [eq]
  exact ⟨Equiv.refl _,definable_identity_label M T B.2.definable⟩

theorem fieldFiberRows_class (p : SortedAssignment Z P)
    (hz : zero.val = M.funMap .rvZero (fun i => i.elim0))
    (bounds : Supp → ℕ) (v : ∀ s, (A.fieldFiberRow idx zero s (bounds s)).valid zero p) :
    let z := M.termGeneratedAssignment (namedTuple S p) .rv (.inl zero)
    fiberClass (fun s => A.fieldFiberRow idx zero s (bounds s)) zero hz p v =
      (A.atFieldTuple p).terminalGradedClass idx z hz := by
  intro z
  exact Finset.sum_congr rfl (fun s _ => A.fieldFiberRow_class idx zero p hz s (bounds s) (v s))

@[expose] def fieldFiberSupportIndex : Fin (Fintype.card Supp) ≃ Supp := (Fintype.equivFin Supp).symm

@[expose] def orderedFieldFiberRows (bounds : Supp → ℕ) : RelativeObjectFamily M S P (Fin (Fintype.card Supp)) :=
  fun i => A.fieldFiberRow idx zero (fieldFiberSupportIndex i) (bounds (fieldFiberSupportIndex i))

theorem orderedFieldFiberRows_class (p : SortedAssignment Z P)
    (hz : zero.val = M.funMap .rvZero (fun i => i.elim0))
    (bounds : Supp → ℕ) (v : ∀ s, (A.fieldFiberRow idx zero s (bounds s)).valid zero p) :
    let z := M.termGeneratedAssignment (namedTuple S p) .rv (.inl zero)
    fiberClass (A.orderedFieldFiberRows idx zero bounds) zero hz p (fun i => v (fieldFiberSupportIndex i)) =
      (A.atFieldTuple p).terminalGradedClass idx z hz := by
  intro z
  let cls (s : Supp) := objectClass M (M.termGenerated (namedTuple S p))
    ⟨(A.fieldFiberRow idx zero s (bounds s)).data.degree,(A.fieldFiberRow idx zero s (bounds s)).realize zero hz p (v s)⟩
  let e := fieldFiberSupportIndex (k := k)
  have eq : (∑ i, cls (e i)) = ∑ s, cls s := Fintype.sum_equiv e (cls ∘ e) cls (fun _ => rfl)
  exact eq.trans (A.fieldFiberRows_class idx zero p hz bounds v)

theorem fieldFiberTags_agree_of_rows (bounds : Supp → ℕ) {p p' : SortedAssignment Z P}
    (agree : RelativeRVTest.Agree (RelativeObjectFamily.tests (A.orderedFieldFiberRows idx zero bounds)) p p')
    (u : SortedAssignment Z U) :
    appendAssignments p u ∈ A.fieldFiberTags idx ↔ appendAssignments p' u ∈ A.fieldFiberTags idx := by
  classical
  let e := fieldFiberSupportIndex (k := k)
  let s := Finset.univ.filter (fun i => u .rv (idx.symm (A.select i)) ≠ zero.val)
  have sup (i : Fin k) : u .rv (idx.symm (A.select i)) ≠ zero.val ↔ i ∈ s := by simp [s]
  have same (z : SortedAssignment Z P) :
      appendAssignments z u ∈ A.fieldFiberTags idx ↔ appendAssignments z u ∈ A.fieldFiberSupportTags idx zero s :=
    ⟨fun h => (A.fieldFiberSupportTags_mem idx zero s z u).2 ⟨h,sup⟩,fun h => h.1⟩
  have order : RelativeRVTest.Agree ((A.fieldFiberRow idx zero s (bounds s)).tests) p p' := by
    have h := RelativeRVTest.agree_family _ agree (e.symm s)
    change RelativeRVTest.Agree ((A.fieldFiberRow idx zero (e (e.symm s)) (bounds (e (e.symm s)))).tests) p p' at h
    rwa [e.apply_symm_apply] at h
  let test := RelativeRVTest.ofSet (A.fieldFiberSupportTags_definable idx zero s)
  have mem : test ∈ (A.fieldFiberRow idx zero s (bounds s)).tests := by
    change test ∈ test :: _
    exact List.mem_cons_self ..
  exact (same p).trans ((order test mem u).trans (same p').symm)

end RetainedFieldFamily

end GeneralizedEuler.Section5
