module

public import Section5.TerminalUnaryEndpointClasses
public import Section5.TerminalUnarySliceClasses
public import Section5.UniformRVBlowupGluing

/-! Arbitrary unary head contractions of the same family have common
blowups across every head-start zero pattern. The local unary kernel
is applied over the base generated by the old selected tuple. -/

public section

noncomputable section

namespace GeneralizedEuler.Section5

open GeneralizedEuler.Section2 GeneralizedEuler.Section4 FirstOrder FirstOrder.Language RelativeObjectFamily

universe z

variable {K : Type z} [Field K] [LinearOrder K] [IsStrictOrderedRing K]
  {L : Language} [L.Structure K] {E : Type*}
  (O : ValuationSubring K) [L.Structure (Residue O)]
  (hO : IsOrderConvex O) (power : E → RV0 O → RV0 O)
  (S : SortedSubstructure (canonicalStructure (L := L) O hO power)) {k t a b : ℕ}

local notation "𝓜" => canonicalStructure (L := L) O hO power
local notation "Z" => CanonicalSort O
local notation "P" => RVVariables (Fin k)

variable {A B : RetainedFieldFamily (canonicalStructure (L := L) O hO power) S 1 k}
  (H : HeadContractionData (n := 0) A) (J : HeadContractionData (n := 0) B)

structure UnaryHeadComparisonHypotheses
    (H : HeadContractionData (n := 0) A) (J : HeadContractionData (n := 0) B) where
  minusOne : L.Term Empty
  minusOne_realizes : minusOne.realize (Empty.elim : Empty → K) = -1
  fieldTerms : FieldTerms (convexLanguage L)
  fieldTerms_realize : letI := convexStructure O L; InterpretsFieldTerms (K := K) fieldTerms
  epsilon : K
  epsilon_nonzero : epsilon ≠ 0
  epsilon_small : O.valuation epsilon < 1
  saturationCover : RealizesFinitelySatisfiableTypes 𝓜 (WithBase S.carrier P) (BaseAssignments S.carrier P)
  saturationRows : ∀ d, RealizesFinitelySatisfiableTypes 𝓜 (WithBase S.carrier (SumVariables P (RVVariables (Fin d))))
    (BaseAssignments S.carrier (SumVariables P (RVVariables (Fin d))))
  saturationBounds : ∀ (p : SortedAssignment Z P) d, let T := (𝓜).termGenerated (namedTuple S p)
    RealizesFinitelySatisfiableTypes 𝓜 (WithBase T.carrier (RVVariables (Fin d))) (BaseAssignments T.carrier (RVVariables (Fin d)))
  saturationCenters : ∀ (p : SortedAssignment Z P), let T := (𝓜).termGenerated (namedTuple S p)
    ∀ I : Type, Finite I → RealizesFinitelySatisfiableTypes 𝓜 (CenterTestVariables T.carrier I) (CenterTestAssignments T.carrier I)
  immediate : ∀ (p : SortedAssignment Z P), let T := (𝓜).termGenerated (namedTuple S p)
    ∀ x y : K, (∀ c : T.carrier .vf, rv O (x-c.val) = rv O (y-c.val)) →
      ∃ e : SortedIsomorphism 𝓜 𝓜, e.toEmbedding .vf x = y ∧
        (∀ c ∈ T.carrier .vf, e.toEmbedding .vf c = c) ∧ ∀ r, e.toEmbedding .rv r = r
  charts : ∀ (p : SortedAssignment Z P), let T := (𝓜).termGenerated (namedTuple S p)
    ∀ f : H.unarySlice (p .rv) ≃ J.unarySlice (p .rv), UnaryMixedGraphDefinable O hO power T f →
      ∃ (I : Type) (_ : Finite I), Nonempty (UnaryChartPartition O hO power T f I)

@[expose] def RetainedFieldFamily.terminalUnaryPatternClass
    (B : RetainedFieldFamily (canonicalStructure (L := L) O hO power) S 0 (k+1)) (tags : Fin a ≃ B.tags)
    (zero : S.carrier .rv) (hz : zero.val = 0) (keep : Fin t → Fin k) : RVSemiring 𝓜 S :=
  objectClass 𝓜 S ⟨t,B.terminalPiece tags (terminalUnaryKeep keep false) zero hz⟩ +
    objectClass 𝓜 S ⟨t+1,B.terminalPiece tags (terminalUnaryKeep keep true) zero hz⟩

set_option maxHeartbeats 800000 in
theorem unary_head_contractions_common_blowup_on_pattern
    (hyp : UnaryHeadComparisonHypotheses O hO power S H J) (neg : rv O (-1) ∈ S.carrier .rv)
    (zero : S.carrier .rv) (hz : zero.val = 0) (keep : Fin t → Fin k)
    (tagsH : Fin a ≃ H.target.tags) (tagsJ : Fin b ≃ J.target.tags)
    (lifted : ∀ (p : SortedAssignment Z P), MixedDefinablyEquivalent 𝓜 ((𝓜).termGenerated (namedTuple S p))
      {a : SortedAssignment Z (MixedVariables 1 H.target.tags) | mixedTuple a ∈ H.liftedSlice (p .rv)}
      {b : SortedAssignment Z (MixedVariables 1 J.target.tags) | mixedTuple b ∈ J.liftedSlice (p .rv)}) :
    CommonBlowup (ElementaryClassStep O hO power S neg)
      (H.target.terminalUnaryPatternClass O hO power S tagsH zero hz keep)
      (J.target.terminalUnaryPatternClass O hO power S tagsJ zero hz keep) := by
  let I : RelativeRVIndex (X := CanonicalSort O) 𝓜 S k t := oldHeadPatternIndex keep zero hz
  obtain ⟨h₀,h₁,vH⟩ := H.target.terminalUnaryRows_valid tagsH zero hyp.saturationRows
  obtain ⟨j₀,j₁,vJ⟩ := J.target.terminalUnaryRows_valid tagsJ zero hyp.saturationRows
  let U := H.target.terminalUnaryRows tagsH zero h₀ h₁
  let V := J.target.terminalUnaryRows tagsJ zero j₀ j₁
  let idxH : Fin (1+a) ≃ Fin 1 ⊕ H.target.tags := finSumFinEquiv.symm.trans (Equiv.sumCongr (Equiv.refl _) tagsH)
  let idxJ : Fin (1+b) ≃ Fin 1 ⊕ J.target.tags := finSumFinEquiv.symm.trans (Equiv.sumCongr (Equiv.refl _) tagsJ)
  have c (p : SortedAssignment Z P) :
      let T := (𝓜).termGenerated (namedTuple S p)
      let nT : rv O (-1) ∈ T.carrier .rv :=
        ((𝓜).termGeneratedAssignment (namedTuple S p) .rv (.inl ⟨_,neg⟩)).property
      CommonBlowup (ElementaryClassStep O hO power T nT) (fiberClass U zero hz p (vH p)) (fiberClass V zero hz p (vJ p)) := by
    intro T nT
    change CommonBlowup (ElementaryClassStep O hO power T nT)
      (fiberClass (H.target.terminalUnaryRows tagsH zero h₀ h₁) zero hz p (vH p))
      (fiberClass (J.target.terminalUnaryRows tagsJ zero j₀ j₁) zero hz p (vJ p))
    rw [H.terminalUnaryRows_class O hO power S tagsH idxH zero hz h₀ h₁ p (vH p),
      J.terminalUnaryRows_class O hO power S tagsJ idxJ zero hz j₀ j₁ p (vJ p)]
    exact unary_head_slice_classes_common_blowup O hO power S H J p idxH idxJ hyp.minusOne hyp.minusOne_realizes
      hyp.fieldTerms hyp.fieldTerms_realize hyp.epsilon_nonzero hyp.epsilon_small neg (hyp.saturationCenters p)
      (hyp.immediate p) (hyp.charts p) (lifted p)
  have glued := uniform_rv_common_blowup_glues O hO power S neg I (A := U) (B := V) zero hz
    (fun p _ => vH (rvTupleAssignment p)) (fun p _ => vJ (rvTupleAssignment p)) hyp.saturationCover
    (fun p _ => hyp.saturationBounds (rvTupleAssignment p)) (fun p _ => c (rvTupleAssignment p))
  change CommonBlowup (ElementaryClassStep O hO power S neg)
    (gluedClass zero hz I (H.target.terminalUnaryRows tagsH zero h₀ h₁) (fun p _ => vH (rvTupleAssignment p)))
    (gluedClass zero hz I (J.target.terminalUnaryRows tagsJ zero j₀ j₁) (fun p _ => vJ (rvTupleAssignment p))) at glued
  rw [H.target.terminalUnaryRows_gluedClass tagsH keep zero hz h₀ h₁ vH,
    J.target.terminalUnaryRows_gluedClass tagsJ keep zero hz j₀ j₁ vJ] at glued
  exact glued

theorem unary_head_contractions_common_blowup
    (hyp : UnaryHeadComparisonHypotheses O hO power S H J) (neg : rv O (-1) ∈ S.carrier .rv)
    (zero : S.carrier .rv) (hz : zero.val = 0)
    (tagsH : Fin a ≃ H.target.tags) (tagsJ : Fin b ≃ J.target.tags)
    (lifted : ∀ (p : SortedAssignment Z P), MixedDefinablyEquivalent 𝓜 ((𝓜).termGenerated (namedTuple S p))
      {a : SortedAssignment Z (MixedVariables 1 H.target.tags) | mixedTuple a ∈ H.liftedSlice (p .rv)}
      {b : SortedAssignment Z (MixedVariables 1 J.target.tags) | mixedTuple b ∈ J.liftedSlice (p .rv)}) :
    let keep (s : Finset (Fin k)) := Subtype.val ∘ (Fintype.equivFin {i // i ∈ s}).symm
    CommonBlowup (ElementaryClassStep O hO power S neg)
      (∑ s : Finset (Fin k), H.target.terminalUnaryPatternClass O hO power S tagsH zero hz (keep s))
      (∑ s : Finset (Fin k), J.target.terminalUnaryPatternClass O hO power S tagsJ zero hz (keep s)) := by
  intro keep
  exact graded_common_blowup_sum O hO power S neg _ _ fun s =>
    unary_head_contractions_common_blowup_on_pattern O hO power S H J hyp neg zero hz (keep s) tagsH tagsJ lifted

end GeneralizedEuler.Section5
