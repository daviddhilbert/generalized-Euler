module

public import Section5.ClassBlowupDiamond
public import Section5.BlowupCongruence

/-! The common-blowup relation on actual positive classes is a semiring
congruence, generated by the blowup of the degree-one point. -/

public section

noncomputable section

namespace GeneralizedEuler.Section5

open GeneralizedEuler.Section2 GeneralizedEuler.Section4 FirstOrder

universe z

variable {K : Type z} [Field K] [LinearOrder K] [IsStrictOrderedRing K]
  {L : Language} [L.Structure K] {E : Type*}
  (O : ValuationSubring K) [L.Structure (Residue O)]
  (hO : IsOrderConvex O) (power : E → RV0 O → RV0 O)
  (S : SortedSubstructure (canonicalStructure (L := L) O hO power))
  (hneg : rv O (-1) ∈ S.carrier .rv)

local notation "𝓜" => canonicalStructure (L := L) O hO power
local notation "R" => RVSemiring 𝓜 S
local notation "cls" => objectClass 𝓜 S
local notation "p" => residuePointClass O hO power S
local notation "q" => multiplierClass O hO power S hneg
local notation "step" => ElementaryClassStep O hO power S hneg
local notation "common" => CommonBlowup step
local notation "equiv" => commonBlowup_equivalence step (elementaryClassStep_diamond O hO power S hneg)

private theorem elementaryClassStep_common {a b : R} (h : step a b) : common a b :=
  ⟨b,1,0,⟨b,h,rfl⟩,rfl⟩

theorem graded_common_blowup_add {a b c d : R} (h : common a b) (g : common c d) :
    common (a+c) (b+d) := by
  have right (x y z : R) (hxy : common x y) : common (x+z) (y+z) :=
    commonBlowup_map step (· + z) (fun _ _ hh => elementaryClassStep_add O hO power S hneg hh z) hxy
  apply (equiv).trans (right a b c h)
  rw [add_comm b c,add_comm b d]
  exact right c d b g

private theorem elementaryClassStep_mul_common {a b : R} (h : step a b) (c : R) : common (a*c) (b*c) := by
  obtain ⟨n,U,rfl⟩ := positive_class_represented 𝓜 S c
  rw [Finset.mul_sum,Finset.mul_sum]
  classical
  have each (I : Finset (Fin n)) : common (∑ i ∈ I, a * cls (U i)) (∑ i ∈ I, b * cls (U i)) := by
    induction I using Finset.induction_on with
    | empty => simp only [Finset.sum_empty]; exact (equiv).refl 0
    | insert i I hi ih =>
      rw [Finset.sum_insert hi,Finset.sum_insert hi]
      exact graded_common_blowup_add O hO power S hneg
        (elementaryClassStep_common O hO power S hneg (elementaryClassStep_mul_object O hO power S hneg h (U i))) ih
  exact each Finset.univ

private theorem classSteps_mul_common {a b : R} {n : ℕ}
    (h : BlowupSteps step n a b) (c : R) : common (a*c) (b*c) := by
  induction n generalizing a with
  | zero =>
    have e : a = b := h
    rw [e]
    exact (equiv).refl _
  | succ n ih =>
    obtain ⟨v,hv,tail⟩ := h
    exact (equiv).trans (elementaryClassStep_mul_common O hO power S hneg hv c) (ih tail)

theorem graded_common_blowup_mul {a b c d : R} (h : common a b) (g : common c d) :
    common (a*c) (b*d) := by
  have right (x y z : R) (hxy : common x y) : common (x*z) (y*z) := by
    obtain ⟨v,m,n,hv,gv⟩ := hxy
    exact (equiv).trans (classSteps_mul_common O hO power S hneg hv z)
      ((equiv).symm (classSteps_mul_common O hO power S hneg gv z))
  apply (equiv).trans (right a b c h)
  rw [mul_comm b c,mul_comm b d]
  exact right c d b g

@[expose] def gradedBlowupCongruence : RingCon R where
  r := common
  iseqv := equiv
  add' := graded_common_blowup_add O hO power S hneg
  mul' := graded_common_blowup_mul O hO power S hneg

theorem degree_one_point_blowup : step p (1+q) := by
  refine Or.inr ⟨⟨0,degreeZeroUnit 𝓜 S⟩,0,?_,?_⟩
  · rw [degreeZeroUnit_class,one_mul,add_zero]
  · rw [degreeZeroUnit_class,one_mul,add_zero]

/-- The geometric common-refinement quotient has exactly the single
generator relation given by the elementary blowup of a point. -/
theorem gradedBlowupCongruence_eq_generated :
    gradedBlowupCongruence O hO power S hneg = ringConGen (fun a b : R => a = p ∧ b = 1+q) := by
  let C := ringConGen (fun a b : R => a = p ∧ b = 1+q)
  have base : C p (1+q) := RingConGen.Rel.of _ _ ⟨rfl,rfl⟩
  have one (a b : R) (h : step a b) : C.mk' a = C.mk' b := by
    apply Quotient.sound
    rcases h with he | ⟨W,rest,ha,hb⟩
    · exact he ▸ C.refl _
    · rw [ha,hb]
      exact C.add (C.mul (C.refl _) base) (C.refl _)
  apply le_antisymm
  · intro a b h
    apply Quotient.exact
    exact commonBlowup_invariant step C.mk' one h
  · apply RingCon.ringConGen_le.mpr
    rintro _ _ ⟨rfl,rfl⟩
    exact elementaryClassStep_common O hO power S hneg (degree_one_point_blowup O hO power S hneg)

end GeneralizedEuler.Section5
