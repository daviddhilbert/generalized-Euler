module

public import Section5.FieldwiseContractionRelations
public import Section5.TailFieldSlices

/-! Pass to a complementary field slice while retaining the same
pointwise RV comparison. The base generated in the two stages is
the base generated by the full original field tuple. -/

public section

noncomputable section

namespace GeneralizedEuler.Section5

open GeneralizedEuler.Section2 GeneralizedEuler.Section4 FirstOrder

universe z

variable {K : Type z} [Field K] [LinearOrder K] [IsStrictOrderedRing K]
  {L : Language} [L.Structure K] {E : Type*}
  {O : ValuationSubring K} [L.Structure (Residue O)]
  {hO : IsOrderConvex O} {power : E → RV0 O → RV0 O}
  (S : SortedSubstructure (canonicalStructure (L := L) O hO power))
  (neg : rv O (-1) ∈ S.carrier .rv) {a b k n : ℕ}

local notation "𝓜" => canonicalStructure (L := L) O hO power
local notation "Z" => CanonicalSort O

theorem fieldwiseCommonBlowup_tail
    {A B : RetainedFieldFamily 𝓜 S (n+1) k} {idxA : Fin a ≃ A.tags} {idxB : Fin b ≃ B.tags}
    (common : fieldwiseCommonBlowup S neg A B idxA idxB) (p : fieldAssignment n Z) :
    let C := (𝓜).termGenerated (namedTuple S p)
    let negC : rv O (-1) ∈ C.carrier .rv :=
      ((𝓜).termGeneratedAssignment (namedTuple S p) .rv (.inl ⟨_,neg⟩)).property
    fieldwiseCommonBlowup C negC (A.fieldTailSlice p) (B.fieldTailSlice p) idxA idxB := by
  intro C negC q
  let w : fieldAssignment (n+1) Z := fieldTupleAssignment (Fin.cons (q .vf 0) (p .vf))
  let U := (𝓜).termGenerated (namedTuple S w)
  let V := (𝓜).termGenerated (namedTuple C q)
  let nu : rv O (-1) ∈ U.carrier .rv :=
    ((𝓜).termGeneratedAssignment (namedTuple S w) .rv (.inl ⟨_,neg⟩)).property
  let nv : rv O (-1) ∈ V.carrier .rv :=
    ((𝓜).termGeneratedAssignment (namedTuple C q) .rv (.inl ⟨_,negC⟩)).property
  have same : U = V := (generated_base_field_head_tail S p q).symm
  have h := terminalCommonBlowup_rebase U nu same nv (A.atFieldTuple w) (B.atFieldTuple w) idxA idxB (common w)
  exact terminalCommonBlowup_of_carriers V nv rfl rfl rfl rfl h

theorem terminalCommonBlowup_of_fieldwise_zero
    {A B : RetainedFieldFamily 𝓜 S 0 k} {idxA : Fin a ≃ A.tags} {idxB : Fin b ≃ B.tags}
    (common : fieldwiseCommonBlowup S neg A B idxA idxB) :
    terminalCommonBlowup S neg A B idxA idxB := by
  let p : fieldAssignment 0 Z := fieldTupleAssignment Fin.elim0
  let T := (𝓜).termGenerated (namedTuple S p)
  let nt : rv O (-1) ∈ T.carrier .rv :=
    ((𝓜).termGeneratedAssignment (namedTuple S p) .rv (.inl ⟨_,neg⟩)).property
  have eq : T = S := generated_base_emptyField S p
  have h := terminalCommonBlowup_rebase T nt eq neg (A.atFieldTuple p) (B.atFieldTuple p) idxA idxB (common p)
  exact terminalCommonBlowup_of_carriers S neg rfl rfl rfl rfl h

theorem headTarget_terminalCommonBlowup_of_tail
    {A B : RetainedFieldFamily 𝓜 S (n+1) k} (H : HeadContractionData A) (J : HeadContractionData B)
    (idxH : Fin a ≃ H.target.tags) (idxJ : Fin b ≃ J.target.tags) (p : fieldAssignment n Z) :
    let C := (𝓜).termGenerated (namedTuple S p)
    let negC : rv O (-1) ∈ C.carrier .rv :=
      ((𝓜).termGeneratedAssignment (namedTuple S p) .rv (.inl ⟨_,neg⟩)).property
    terminalCommonBlowup C negC (H.atFieldTail p).target (J.atFieldTail p).target idxH idxJ →
      terminalCommonBlowup C negC (H.target.atFieldTuple p) (J.target.atFieldTuple p) idxH idxJ := by
  intro C negC v
  apply terminalCommonBlowup_of_carriers C negC _ rfl _ rfl v
  · ext x
    exact H.atFieldTail_target p (x ∘ idxH.symm)
  · ext x
    exact J.atFieldTail_target p (x ∘ idxJ.symm)

end GeneralizedEuler.Section5
