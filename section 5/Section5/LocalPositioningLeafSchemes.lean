module

public import Section5.PositioningChartLeaves
public import Section5.PositioningLeafSemantics
public import Section5.UnaryLifting

/-! A prepared unary branch graph supplies an actual leaf-label
scheme over the base generated by its original parameters. -/

public section

noncomputable section

namespace GeneralizedEuler.Section5

open GeneralizedEuler.Section2 GeneralizedEuler.Section3 FirstOrder

universe z

section HistoryGraph

variable {K : Type z} [Field K] {O : ValuationSubring K}
  {L : Language} {E : Type*} {M : SortedStructure L E (CanonicalSort O)} {S : SortedSubstructure M}
  {m ℓ : ℕ}

local notation "Z" => CanonicalSort O
local notation "U" => MixedVariables 1 Empty
local notation "R" => RVVariables (Fin m)

/-- Project away the prepared field value while keeping the original
field coordinate and the entire history as the label. -/
theorem unary_history_fibers_definable
    (P : UnaryPreparation O (PreparationLabels O (RV0 O) ℓ))
    (idx : Fin m ≃ HistoryIndex ℓ)
    (mapGraph : SortedDefinableOver M S.carrier
      {a : SortedAssignment Z (MixedVariables 2 (HistoryIndex ℓ)) |
        P.map (a .vf 0) = (a .vf 1,decodeHistory O ℓ (a .rv))})
    (D : Set (fieldAssignment 1 Z)) (d : SortedDefinableOver M S.carrier D) :
    SortedDefinableOver M S.carrier {p : SortedAssignment Z (SumVariables R U) |
      (fun s => p s ∘ Sum.inr) ∈ D ∧
      P.label (p .vf (.inr 0)) = decodeHistory O ℓ (p .rv ∘ Sum.inl ∘ idx.symm)} := by
  let V := SumVariables R U
  let W := SumVariables V U
  let keep : (s : TCsort) → MixedVariables 2 (HistoryIndex ℓ) s → W s
    | .vf => Fin.cases (.inl (.inr 0)) (fun _ => .inr 0)
    | .rv => Sum.inl ∘ Sum.inl ∘ idx.symm
  have graph := definable_project_mixed (mapGraph.pullback_relabel keep)
  have d' := d.pullback_relabel (fun s => (Sum.inr : U s → V s))
  convert d'.inter graph using 1
  ext p
  refine and_congr_right (fun _ => ?_)
  let q := decodeHistory O ℓ (p .rv ∘ Sum.inl ∘ idx.symm)
  change P.label (p .vf (.inr 0)) = q ↔
    ∃ x : fieldAssignment 1 Z, P.map (p .vf (.inr 0)) = (x .vf 0,q)
  exact ⟨fun e => ⟨fieldTupleAssignment (fun _ => (P.map (p .vf (.inr 0))).1),Prod.ext rfl e⟩,
    fun ⟨_,e⟩ => congrArg Prod.snd e⟩

end HistoryGraph

variable {K : Type z} [Field K] [LinearOrder K] [IsStrictOrderedRing K]
  {L : Language} [L.Structure K] {E : Type*} (O : ValuationSubring K) [L.Structure (Residue O)]
  (hO : IsOrderConvex O) (power : E → RV0 O → RV0 O)
  (S : SortedSubstructure (canonicalStructure (L := L) O hO power)) {P : TCsort → Type}

local notation "𝓜" => canonicalStructure (L := L) O hO power
local notation "Z" => CanonicalSort O
local notation "U" => MixedVariables 1 Empty
local notation "PV" => SumVariables P U
local notation "PVV" => SumVariables PV U

theorem positioning_leaf_scheme_of_prepared_charts
    (p : SortedAssignment Z P)
    {D : Set (SortedAssignment Z PV)} {G : Set (SortedAssignment Z PVV)}
    (d : SortedDefinableOver 𝓜 S.carrier D)
    (A : Set K) (f : K → K)
    (dom : ∀ a : fieldAssignment 1 Z, appendAssignments p a ∈ D ↔ a .vf 0 ∈ A)
    (graph : ∀ a b : fieldAssignment 1 Z, a .vf 0 ∈ A →
      (appendAssignments (appendAssignments p a) b ∈ G ↔ f (a .vf 0) = b .vf 0))
    {ℓ : ℕ} (L' : UnaryPreparation O (PreparationLabels O (RV0 O) ℓ))
    (mapGraph : SortedDefinableOver 𝓜 ((𝓜).termGenerated (namedTuple S p)).carrier
      {a : SortedAssignment Z (MixedVariables 2 (HistoryIndex ℓ)) |
        L'.map (a .vf 0) = (a .vf 1,decodeHistory O ℓ (a .rv))})
    (shape : ∀ x ∈ A, let C := L'.label ⁻¹' {L'.label x}
      C ⊆ A ∧
      (C = {x} ∨ ∃ r : O.ValueGroup, r ≠ 0 ∧ C = openDisc O x r ∧
        ((∀ a ∈ C, ∀ b ∈ C, f a = f b) ∨ ∃ (b : K) (s : O.ValueGroup) (u : RV O),
          s ≠ 0 ∧ f '' C = openDisc O b s ∧ RVAffineOn O C f u))) :
    ∃ W : PositioningLeafScheme 𝓜 S P, W.valid O hO power S D G p := by
  classical
  let m := Nat.card (HistoryIndex ℓ)
  let idx : Fin m ≃ HistoryIndex ℓ := (Finite.equivFin _).symm
  let R := RVVariables (Fin m)
  let B := (𝓜).termGenerated (namedTuple S p)
  let D₀ := {a : fieldAssignment 1 Z | appendAssignments p a ∈ D}
  have d₀ : SortedDefinableOver 𝓜 B.carrier D₀ := definable_scheme_at_fiber p D d
  let V := SumVariables R U
  let F₀ : Set (SortedAssignment Z V) :=
    {a | (fun s => a s ∘ Sum.inr) ∈ D₀ ∧
      L'.label (a .vf (.inr 0)) = decodeHistory O ℓ (a .rv ∘ Sum.inl ∘ idx.symm)}
  have f₀ : SortedDefinableOver 𝓜 B.carrier F₀ := unary_history_fibers_definable L' idx mapGraph D₀ d₀
  obtain ⟨F',defF',eqF'⟩ := definable_fiber_as_scheme p F₀ f₀
  let assoc (s : TCsort) : SumVariables P V s → SumVariables (SumVariables P R) U s :=
    Sum.elim (Sum.inl ∘ Sum.inl) (Sum.elim (Sum.inl ∘ Sum.inr) Sum.inr)
  let W : PositioningLeafScheme 𝓜 S P :=
    ⟨m,{a | (fun s => a s ∘ assoc s) ∈ F'},defF'.pullback_relabel assoc⟩
  have mem (r : SortedAssignment Z R) (a : fieldAssignment 1 Z) :
      appendAssignments (appendAssignments p r) a ∈ W.leaves ↔
        a .vf 0 ∈ A ∧ L'.label (a .vf 0) = decodeHistory O ℓ (r .rv ∘ idx.symm) := by
    have e : (fun s => appendAssignments (appendAssignments p r) a s ∘ assoc s) =
        appendAssignments p (appendAssignments r a) := by
      funext s i
      rcases i with i | (i | i) <;> rfl
    change (fun s => appendAssignments (appendAssignments p r) a s ∘ assoc s) ∈ F' ↔ _
    rw [e,eqF']
    change appendAssignments p a ∈ D ∧
      L'.label (a .vf 0) = decodeHistory O ℓ (r .rv ∘ idx.symm) ↔ _
    rw [dom]
  have named (r : SortedAssignment Z R) :
      encodeHistory O ℓ (decodeHistory O ℓ (r .rv ∘ idx.symm)) ∘ idx = r .rv := by
    rw [encode_decode_history]
    funext i
    exact congrArg (r .rv) (idx.symm_apply_apply i)
  refine ⟨W,?_,?_,?_⟩
  · intro a
    rw [dom]
    constructor
    · intro h
      let r : SortedAssignment Z R := rvTupleAssignment (encodeHistory O ℓ (L'.label (a .vf 0)) ∘ idx)
      refine ⟨r,(mem r a).2 ⟨h,?_⟩⟩
      have e : r .rv ∘ idx.symm = encodeHistory O ℓ (L'.label (a .vf 0)) := by
        funext i
        exact congrArg (encodeHistory O ℓ (L'.label (a .vf 0))) (idx.apply_symm_apply i)
      rw [e,decode_encode_history]
    · rintro ⟨r,h⟩
      exact ((mem r a).1 h).1
  · intro a r s hr hs
    have eq := ((mem r a).1 hr).2.symm.trans ((mem s a).1 hs).2
    funext j i
    cases j with
    | vf => exact i.elim
    | rv => exact congrFun ((named r).symm.trans ((congrArg (fun t => encodeHistory O ℓ t ∘ idx) eq).trans (named s))) i
  · intro r
    let C : Set K := {x ∈ A | L'.label x = decodeHistory O ℓ (r .rv ∘ idx.symm)}
    have data (a b : fieldAssignment 1 Z) (inside : a .vf 0 ∈ C) :
        (appendAssignments (appendAssignments (appendAssignments p r) a) b ∈ W.graphLift O hO power S G ↔
          f (a .vf 0) = b .vf 0) := by
      have g := graph a b inside.1
      refine Iff.trans ?_ g
      change (fun s => appendAssignments (appendAssignments (appendAssignments p r) a) b s ∘
        Sum.elim (Sum.elim (Sum.inl ∘ Sum.inl ∘ Sum.inl) (Sum.inl ∘ Sum.inr)) Sum.inr) ∈ G ↔ _
      have e : (fun s => appendAssignments (appendAssignments (appendAssignments p r) a) b s ∘
        Sum.elim (Sum.elim (Sum.inl ∘ Sum.inl ∘ Sum.inl) (Sum.inl ∘ Sum.inr)) Sum.inr) =
          appendAssignments (appendAssignments p a) b := by
        funext s i
        rcases i with (i | i) | i <;> rfl
      rw [e]
    refine positioningLeafValid_of_geometry O (appendAssignments p r) C f (mem r) data ?_
    by_cases empty : C = ∅
    · exact Or.inl empty
    · obtain ⟨x,hx⟩ := Set.nonempty_iff_ne_empty.2 empty
      obtain ⟨sub,geo⟩ := shape x hx.1
      have eq : C = L'.label ⁻¹' {L'.label x} := by
        ext y
        change y ∈ A ∧ L'.label y = decodeHistory O ℓ (r .rv ∘ idx.symm) ↔ L'.label y = L'.label x
        rw [← hx.2]
        exact ⟨And.right,fun h => ⟨sub h,h⟩⟩
      rw [eq]
      rcases geo with point | disc
      · exact Or.inr (Or.inl ⟨x,point⟩)
      · obtain ⟨r,nz,disc,rest⟩ := disc
        exact Or.inr (Or.inr ⟨x,r,nz,disc,rest⟩)

end GeneralizedEuler.Section5
