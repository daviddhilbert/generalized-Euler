module

public import Section5.HeadContractionFamilies
public import Section5.GeneratedParameterSchemes
public import Section5.MixedGraphIsomorphisms

/-! Freeze the selected RV coordinates of a retained-field family.
All its tags stay in the fiber and it is definable over the base
generated by the selected tuple. -/

public section

noncomputable section

namespace GeneralizedEuler.Section5

open GeneralizedEuler.Section2 FirstOrder

universe z

variable {K : Type z} [Field K] {O : ValuationSubring K}
  {L : Language} {E : Type*}
  {M : SortedStructure L E (CanonicalSort O)} {S : SortedSubstructure M}
  {n k : ℕ}

namespace RetainedFieldFamily

variable (A : RetainedFieldFamily M S n k)

@[expose] def selectedFiber (v : Fin k → RV0 O) : Set (PreparationPoint O (Fin n) A.tags) :=
  {p ∈ A.carrier | p.2 ∘ A.select = v}

@[expose] def selectionScheme :
    Set (SortedAssignment (CanonicalSort O) (SumVariables (RVVariables (Fin k)) (MixedVariables n A.tags))) :=
  {a | mixedTuple (fun s => a s ∘ Sum.inr) ∈ A.carrier ∧
    (a .rv ∘ Sum.inr) ∘ A.select = a .rv ∘ Sum.inl}

theorem selectionScheme_definable : SortedDefinableOver M S.carrier A.selectionScheme := by
  let W := SumVariables (RVVariables (Fin k)) (MixedVariables n A.tags)
  let take (s : TCsort) : MixedVariables n A.tags s → W s := Sum.inr
  have raw := A.definable.pullback_relabel take
  have eqs := SortedDefinableOver.iInter (fun i : Fin k =>
    SortedDefinableOver.coordinate_eq (M := M) (A := S.carrier) (Var := W) .rv (.inr (A.select i)) (.inl i))
  convert raw.inter eqs using 1
  ext a
  simp only [selectionScheme,Set.mem_ofPred_eq,Set.mem_inter_iff,Set.mem_iInter]
  change (_ ∧ (a .rv ∘ Sum.inr) ∘ A.select = a .rv ∘ Sum.inl) ↔
    (_ ∧ ∀ i : Fin k, a .rv (.inr (A.select i)) = a .rv (.inl i))
  exact and_congr_right fun _ => ⟨congrFun,funext⟩

theorem selectedFiber_definable (p : SortedAssignment (CanonicalSort O) (RVVariables (Fin k))) :
    SortedDefinableOver M (M.termGenerated (namedTuple S p)).carrier
      {u : SortedAssignment (CanonicalSort O) (MixedVariables n A.tags) | mixedTuple u ∈ A.selectedFiber (p .rv)} := by
  convert definable_scheme_at_fiber p A.selectionScheme A.selectionScheme_definable using 1
  ext u
  have eq : (fun s => appendAssignments p u s ∘ Sum.inr) = u := by
    funext s i
    rfl
  change (_ ∧ _) ↔ (mixedTuple (fun s => appendAssignments p u s ∘ Sum.inr) ∈ A.carrier ∧ _)
  rw [eq]
  rfl

theorem selectedFiber_finite (v : Fin k → RV0 O) (x : Fin n → K) :
    {t | (x,t) ∈ A.selectedFiber v}.Finite :=
  A.finiteFibers x v

theorem selectedFibers_equivalent_of_iso (B : RetainedFieldFamily M S n k)
    (f : MixedGraphIso M S
      {a : SortedAssignment (CanonicalSort O) (MixedVariables n A.tags) | mixedTuple a ∈ A.carrier}
      {b : SortedAssignment (CanonicalSort O) (MixedVariables n B.tags) | mixedTuple b ∈ B.carrier})
    (selected : ∀ x, (f.equiv x).val .rv ∘ B.select = x.val .rv ∘ A.select)
    (p : SortedAssignment (CanonicalSort O) (RVVariables (Fin k))) :
    MixedDefinablyEquivalent M (M.termGenerated (namedTuple S p))
      {a : SortedAssignment (CanonicalSort O) (MixedVariables n A.tags) | mixedTuple a ∈ A.selectedFiber (p .rv)}
      {b : SortedAssignment (CanonicalSort O) (MixedVariables n B.tags) | mixedTuple b ∈ B.selectedFiber (p .rv)} := by
  let T := M.termGenerated (namedTuple S p)
  let D := {a : SortedAssignment (CanonicalSort O) (MixedVariables n A.tags) | mixedTuple a ∈ A.selectedFiber (p .rv)}
  let C := {b : SortedAssignment (CanonicalSort O) (MixedVariables n B.tags) | mixedTuple b ∈ B.selectedFiber (p .rv)}
  have base : ∀ s, S.carrier s ⊆ T.carrier s := fun s x hx =>
    (M.termGeneratedAssignment (namedTuple S p) s (.inl ⟨x,hx⟩)).property
  let fT : MixedGraphIso M T _ _ := ⟨f.equiv,f.definable.mono base⟩
  have dsub : D ⊆ {a | mixedTuple a ∈ A.carrier} := fun _ h => h.1
  have eq : fT.rangeOver dsub = C := by
    ext y
    constructor
    · rintro ⟨x,rfl⟩
      let z := f.equiv ⟨x.val,dsub x.property⟩
      exact ⟨z.property,(selected ⟨x.val,dsub x.property⟩).trans x.property.2⟩
    · intro hy
      let y' := (⟨y,hy.1⟩ : {b : SortedAssignment (CanonicalSort O) (MixedVariables n B.tags) | mixedTuple b ∈ B.carrier})
      let x := f.equiv.symm y'
      have same : f.equiv x = y' := f.equiv.apply_symm_apply y'
      have h := selected x
      rw [same] at h
      have hx : x.val ∈ D := ⟨x.property,h.symm.trans hy.2⟩
      exact ⟨⟨x.val,hx⟩,congrArg Subtype.val same⟩
  have r := fT.restrict dsub (A.selectedFiber_definable p)
  exact (show MixedGraphIso M T D C from eq ▸ r).equivalent

end RetainedFieldFamily

end GeneralizedEuler.Section5
