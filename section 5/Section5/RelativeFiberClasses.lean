module

public import Section5.RelativeRVObjectRealization
public import Section5.LiftFieldObjects
public import Section5.FieldClassPartitions

/-! A valid graded relative scheme represents the class of the
original fiber over the substructure generated by its parameters. -/

public section

noncomputable section

namespace GeneralizedEuler.Section5

open GeneralizedEuler.Section2 GeneralizedEuler.Section4 FirstOrder

universe z

variable {L : Language} {E : Type*} {X : TCsort → Type z}
  {M : SortedStructure L E X} {S : SortedSubstructure M} {P : TCsort → Type}
  [TopologicalSpace (X .vf)] {n m : ℕ}

local notation "U" => MixedVariables n (Fin m)

@[expose] def mixedFieldObject (S : SortedSubstructure M)
    (A : Set (SortedAssignment X U))
    (defA : SortedDefinableOver M S.carrier A)
    (finiteFibers : ∀ x : Fin n → X .vf, {r | (x,r) ∈ mixedTuple '' A}.Finite) : VFObject M S :=
  ⟨n, {
    vfArity := n
    rvArity := m
    carrier := A
    definable := defA
    dimension := ambient_vf_dimension_bound _
    finiteFibers := finiteFibers }⟩

theorem RelativeGradedLiftScheme.fiber_class_eq_sum
    (W : RelativeGradedLiftScheme M S P U)
    (A : Set (SortedAssignment X (SumVariables P U))) (defA : SortedDefinableOver M S.carrier A)
    (p : SortedAssignment X P) (zero : S.carrier .rv)
    (hzero : zero.val = M.funMap .rvZero (fun j => j.elim0))
    (valid : W.valid zero A p)
    (finiteFibers : ∀ x : Fin n → X .vf,
      {r | (x,r) ∈ mixedTuple '' {u : SortedAssignment X U | appendAssignments p u ∈ A}}.Finite) :
    let T := M.termGenerated (namedTuple S p)
    ∃ B : ∀ i : Fin W.count, RVObject M T (W.object i).degree,
      (∀ i, (B i).arity = (W.object i).arity) ∧
      (∀ i, MixedDefinablyEquivalent M T {u | appendAssignments p u ∈ W.source i}
        (ObjectLift.carrier (B i))) ∧
      fieldClass M T (mixedFieldObject T _ (definable_scheme_at_fiber p A defA) finiteFibers) =
        ∑ i, liftObjectClass ⟨(W.object i).degree,B i⟩ := by
  intro T
  classical
  let A₀ := mixedFieldObject T _ (definable_scheme_at_fiber p A defA) finiteFibers
  let D (i : Fin W.count) : Set (SortedAssignment X U) := {u | appendAssignments p u ∈ W.source i}
  have defD (i : Fin W.count) : SortedDefinableOver M T.carrier (D i) :=
    definable_scheme_at_fiber p (W.source i) (W.sourceDefinable i)
  have sub (i : Fin W.count) : D i ⊆ A₀.2.carrier :=
    fun u hu => (valid.1 u).2 ⟨i,hu⟩
  have disj : Pairwise (fun i j => Disjoint (D i) (D j)) :=
    fun i j ne => Set.disjoint_left.2 (fun u hi hj => valid.2.1 i j ne u ⟨hi,hj⟩)
  have cover : (⋃ i, D i) = A₀.2.carrier := by
    ext u
    rw [Set.mem_iUnion]
    exact (valid.1 u).symm
  choose B arity iso using fun i : Fin W.count =>
    (W.object i).has_actual_lift p (W.source i) zero hzero (valid.2.2 i)
  refine ⟨B,arity,iso,(fieldClass_partition A₀ D defD sub disj cover).trans ?_⟩
  refine Finset.sum_congr rfl (fun i _ => ?_)
  exact fieldClass_of_iso M T
    (A := restrictedFieldObject A₀ (D i) (sub i) (defD i))
    (B := ⟨(W.object i).degree,liftFieldObject (B i)⟩) (iso i)

end GeneralizedEuler.Section5
