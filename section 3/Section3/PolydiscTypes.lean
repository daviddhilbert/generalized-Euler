module

public import Section3.ImmediateDiscs
public import Section3.Atomicity

public section

namespace GeneralizedEuler.Section3

open GeneralizedEuler.Section2 FirstOrder FirstOrder.Language Set

variable {K : Type*} {n : ℕ} {P : Type*} {L : Language} [L.Structure K]

/-- When all points of a rectangle have the same pure-field type, the
ith factor misses every field term in the base and the other fixed
coordinates. The equality with such a term would split that factor. -/
theorem factor_disjoint_field_closure (p : P → K) (D : Fin n → Set K)
    (hD : ∀ i, (D i).Nontrivial)
    (htype : ∀ x, (∀ j, x j ∈ D j) → ∀ y, (∀ j, y j ∈ D j) →
      ∀ φ : L.Formula (P ⊕ Fin n), φ.Realize (Sum.elim p x) ↔ φ.Realize (Sum.elim p y))
    (x : Fin n → K) (hx : ∀ j, x j ∈ D j) (i : Fin n) :
    let names : P ⊕ {j : Fin n // j ≠ i} → K := Sum.elim p (fun j => x j)
    Disjoint (D i) (Substructure.closure L (range names) : Set K) := by
  classical
  intro names
  apply disjoint_left.mpr
  intro c hc hcl
  obtain ⟨t,ht⟩ := Substructure.mem_closure_iff_exists_term.mp hcl
  let pick (z : range names) := z.property.choose
  let rename : range names → P ⊕ Fin n := Sum.map id Subtype.val ∘ pick
  let φ := (Term.var (.inr i) : L.Term (P ⊕ Fin n)).equal (t.relabel rename)
  have eval (v : K) : φ.Realize (Sum.elim p (Function.update x i v)) ↔ v = c := by
    have h : Sum.elim p (Function.update x i v) ∘ rename = Subtype.val := by
      funext z
      change Sum.elim p (Function.update x i v) (Sum.map id Subtype.val (pick z)) = z.val
      rw [← z.property.choose_spec]
      change _ = names (pick z)
      cases pick z with
      | inl a => rfl
      | inr j => exact Function.update_of_ne j.property _ _
    simp only [φ,Formula.realize_equal,Term.realize_var,Sum.elim_inr,Function.update_self,
      Term.realize_relabel,h,ht]
  have mem (v : K) (hv : v ∈ D i) (j : Fin n) : Function.update x i v j ∈ D j := by
    by_cases he : j = i
    · subst j; simpa using hv
    · simpa [Function.update_of_ne he] using hx j
  obtain ⟨b,hb,hbc⟩ := (hD i).exists_ne c
  exact hbc ((eval b).mp ((htype _ (mem c hc) _ (mem b hb) φ).mp ((eval c).mpr rfl)))

/-- A product is transitive if one can move one coordinate inside its
factor while fixing all the other coordinates. The relation carries the
required automorphism and the base it fixes. -/
theorem transitive_on_rectangle {D : Fin n → Set K} (R : (Fin n → K) → (Fin n → K) → Prop)
    (hrefl : ∀ x, R x x) (htrans : ∀ {x y z}, R x y → R y z → R x z)
    (hmove : ∀ x, (∀ j, x j ∈ D j) → ∀ i v, v ∈ D i → R x (Function.update x i v))
    (x y : Fin n → K) (hx : ∀ i, x i ∈ D i) (hy : ∀ i, y i ∈ D i) : R x y := by
  classical
  let path (k : ℕ) (j : Fin n) := if j.val < k then y j else x j
  have hm (k j) : path k j ∈ D j := by unfold path; split <;> first | exact hx j | exact hy j
  have move : ∀ k ≤ n, R x (path k) := by
    intro k
    induction k with
    | zero => intro _; simpa [path] using hrefl x
    | succ k ih =>
      intro hk
      let i : Fin n := ⟨k,by omega⟩
      have he : Function.update (path k) i (y i) = path (k+1) := by
        funext j
        by_cases hji : j = i
        · subst j; simp [path,i]
        · have hne : j.val ≠ k := fun h => hji (Fin.ext h)
          rw [Function.update_of_ne hji]
          by_cases h : j.val < k
          · simp [path,h,show j.val < k+1 by omega]
          · simp [path,h,show ¬ j.val < k+1 by omega]
      exact htrans (ih (by omega)) (he ▸ hmove _ (hm k) i _ (hy i))
  simpa [path] using move n le_rfl

/-- Lemma 3.15 in the two-sorted structure. The unary lifting premise is
the prescribed-point conclusion of Section 2, applied only to the field
generated by the original VF parameters and the fixed coordinates. -/
theorem immediate_transitivity_of_field_type {E : Type*} [Field K] [LinearOrder K]
    [IsStrictOrderedRing K] (O : ValuationSubring K) [L.Structure (Residue O)]
    (hO : IsOrderConvex O) (powers : E → RV0 O → RV0 O) (p : P → K)
    (c : Fin n → K) (r : Fin n → O.ValueGroup)
    (hD : ∀ i, (openDisc O (c i) (r i)).Nontrivial)
    (htype : ∀ x, (∀ j, x j ∈ openDisc O (c j) (r j)) →
      ∀ y, (∀ j, y j ∈ openDisc O (c j) (r j)) → ∀ φ : L.Formula (P ⊕ Fin n),
        φ.Realize (Sum.elim p x) ↔ φ.Realize (Sum.elim p y))
    (lift : ∀ (i : Fin n) (x : Fin n → K) (a b : K),
      let F := Substructure.closure L (range
        (Sum.elim p (fun j : {j : Fin n // j ≠ i} => x j)))
      (∀ d : F, rv O (a - d.val) = rv O (b - d.val)) →
      ∃ e : SortedIsomorphism (canonicalStructure (L := L) O hO powers)
          (canonicalStructure O hO powers),
        e.toEmbedding .vf a = b ∧ (∀ d : F, e.toEmbedding .vf d.val = d.val) ∧
        ∀ t, e.toEmbedding .rv t = t)
    (x y : Fin n → K) (hx : ∀ j, x j ∈ openDisc O (c j) (r j))
    (hy : ∀ j, y j ∈ openDisc O (c j) (r j)) :
    ∃ e : SortedIsomorphism (canonicalStructure (L := L) O hO powers)
        (canonicalStructure O hO powers),
      (∀ j, e.toEmbedding .vf (x j) = y j) ∧ (∀ a, e.toEmbedding .vf (p a) = p a) ∧
      ∀ t, e.toEmbedding .rv t = t := by
  classical
  let M := canonicalStructure (L := L) O hO powers
  let R (z w : Fin n → K) := ∃ e : SortedIsomorphism M M,
    (∀ j, e.toEmbedding .vf (z j) = w j) ∧ (∀ a, e.toEmbedding .vf (p a) = p a) ∧
      ∀ t, e.toEmbedding .rv t = t
  apply transitive_on_rectangle (D := fun j => openDisc O (c j) (r j)) R _ _ _ x y hx hy
  · intro z
    let e : SortedIsomorphism M M := {
      toEmbedding := fun _ => Function.Embedding.refl _
      map_fun := fun _ _ => rfl
      map_rel := fun _ _ => Iff.rfl
      surjective := fun _ => Function.surjective_id }
    exact ⟨e,fun _ => rfl,fun _ => rfl,fun _ => rfl⟩
  · rintro z w u ⟨f,hf,hp,hv⟩ ⟨g,hg,hp',hv'⟩
    let e : SortedIsomorphism M M := {
      toSortedEmbedding := g.toSortedEmbedding.comp f.toSortedEmbedding
      surjective := fun s => (g.surjective s).comp (f.surjective s) }
    exact ⟨e,fun i => (congrArg (g.toEmbedding .vf) (hf i)).trans (hg i),
      fun a => (congrArg (g.toEmbedding .vf) (hp a)).trans (hp' a),
      fun t => (congrArg (g.toEmbedding .rv) (hv t)).trans (hv' t)⟩
  · intro z hz i v hv
    let names := Sum.elim p (fun j : {j : Fin n // j ≠ i} => z j)
    let F := Substructure.closure L (range names)
    have hd := factor_disjoint_field_closure p _ hD htype z hz i
    obtain ⟨e,he,hfix,hRV⟩ := lift i z (z i) v (fun d =>
      rv_translate_constant_off_disc O (hz i) hv
        (fun hm => Set.disjoint_left.mp hd hm d.property))
    refine ⟨e,?_,fun a => hfix ⟨p a, Substructure.subset_closure ⟨.inl a,rfl⟩⟩,hRV⟩
    intro j
    by_cases hij : j = i
    · subst j; simpa using he
    · rw [Function.update_of_ne hij]
      exact hfix ⟨z j, Substructure.subset_closure ⟨.inr ⟨j,hij⟩,rfl⟩⟩

end GeneralizedEuler.Section3
