module

public import Section3.Atomicity
public import Section2.SortedQE

public section

namespace GeneralizedEuler.Section3

open GeneralizedEuler.Section2 FirstOrder Set

variable {X C I : Type*}

/-- A cell of the finite partition generated by a family of predicates.
Both membership in the domain and the original base are retained. -/
def truthCell (A : Set X) (B : I → Set X) (indices : Finset I)
    (pattern : indices → Bool) : Set X :=
  {x | x ∈ A ∧ ∀ i : indices, x ∈ B i ↔ pattern i = true}

theorem mem_truthCell (A : Set X) (B : I → Set X) (F : Finset I) {x : X} (hx : x ∈ A) :
    ∃ pat, x ∈ truthCell A B F pat := by
  classical
  exact ⟨fun i => decide (x ∈ B i),hx,fun _ => by simp⟩

theorem disjoint_truthCells (A : Set X) (B : I → Set X) (F : Finset I)
    {p q : F → Bool} (hne : p ≠ q) : Disjoint (truthCell A B F p) (truthCell A B F q) := by
  refine disjoint_left.mpr (fun x hx hy => hne (funext (fun i => ?_)))
  have h := (hx.2 i).symm.trans (hy.2 i)
  cases hp : p i <;> cases hq : q i <;> simp_all

/-- A finite cover of the bad imaginary objects by splitting formulas
produces the pure-field partition of 3.16–3.17. The bad predicate itself
can be in the expanded language. The same argument applies to 3.24. -/
theorem no_bad_object_in_truthCell (A : Set X) (B : I → Set X) (F : Finset I)
    (points : C → Set X) (bad : Set C)
    (hs : ∀ c ∈ bad, ∃ i ∈ F, (points c ∩ B i).Nonempty ∧ (points c \ B i).Nonempty)
    (pat : F → Bool) {c : C} (hc : points c ⊆ truthCell A B F pat) : c ∉ bad := by
  intro hbad
  obtain ⟨i,hi,⟨x,hx,hxi⟩,y,hy,hyi⟩ := hs _ hbad
  let j : F := ⟨i,hi⟩
  exact hyi (((hc hy).2 j).mpr (((hc hx).2 j).mp hxi))

/-- Compactness step of the partition argument over the original field
base. Pointed models carry the bad-disc code (or representatives) and
the parameters. Each splitting test refers to an original field formula. -/
theorem finite_splitting_schemes {L : Language} {E : Type*} {Var : TCsort → Type*}
    (T : SortedTheory L E) (bad : SortedFormula L E Var)
    (cuts : I → SortedFormula L E Var)
    (htype : ∀ P : T.PointedModel Var, P.realizes bad →
      ¬ ∀ i, ¬ P.realizes (cuts i)) :
    ∃ F : Finset I, ∀ P : T.PointedModel Var, P.realizes bad →
      ∃ i ∈ F, P.realizes (cuts i) := by
  classical
  apply T.exists_finite_formula_cover bad cuts
  intro P hP
  exact not_forall_not.mp (htype P hP)

/-- Same-base definability of the truth cells in the two-sorted language. -/
theorem sortedDefinable_truthCell {L : Language} {E : Type*} {Z : TCsort → Type*}
    {M : SortedStructure L E Z} {S : ∀ s, Set (Z s)} {Var : TCsort → Type*}
    {A : Set (∀ s, Var s → Z s)} {B : I → Set (∀ s, Var s → Z s)}
    (hA : SortedDefinableOver M S A) (hB : ∀ i, SortedDefinableOver M S (B i))
    (F : Finset I) (pat : F → Bool) : SortedDefinableOver M S (truthCell A B F pat) := by
  let piece (i : F) := if pat i then B i else (B i)ᶜ
  have hpiece (i : F) : SortedDefinableOver M S (piece i) := by
    cases hi : pat i <;> simp only [piece,hi,Bool.false_eq_true,ite_false,ite_true]
    · exact (hB i).compl
    · exact hB i
  convert hA.inter (SortedDefinableOver.iInter hpiece) using 1
  ext x
  simp only [truthCell,mem_ofPred_eq,mem_inter_iff,mem_iInter]
  apply and_congr_right
  intro _
  exact forall_congr' (fun i => by cases h : pat i <;> simp [piece,h])

/-- A fixed finite family of choices in 3.3 gives a genuine partition by
the first agreeing choice, even where several choices coincide. -/
def firstChoicePiece {n : ℕ} (f : X → C) (g : Fin n → X → C) (i : Fin n) : Set X :=
  {x | f x = g i x ∧ ∀ j < i, f x ≠ g j x}

theorem firstChoice_partition {n : ℕ} (f : X → C) (g : Fin n → X → C)
    (cover : ∀ x, ∃ i, f x = g i x) : ∀ x, ∃! i, x ∈ firstChoicePiece f g i := by
  classical
  intro x
  let U := Finset.univ.filter (fun i => f x = g i x)
  have hU : U.Nonempty := by
    obtain ⟨j,hj⟩ := cover x
    exact ⟨j,Finset.mem_filter.mpr ⟨Finset.mem_univ _,hj⟩⟩
  let i := U.min' hU
  have hm := U.min'_mem hU
  have hxi : x ∈ firstChoicePiece f g i := by
    refine ⟨(Finset.mem_filter.mp hm).2,fun j hj he => ?_⟩
    exact hj.not_ge (U.min'_le j (Finset.mem_filter.mpr ⟨Finset.mem_univ _,he⟩))
  refine ⟨i,hxi,fun j hj => le_antisymm ?_ (U.min'_le j (Finset.mem_filter.mpr
    ⟨Finset.mem_univ _,hj.1⟩))⟩
  exact le_of_not_gt (fun h => hj.2 i h hxi.1)

end GeneralizedEuler.Section3
