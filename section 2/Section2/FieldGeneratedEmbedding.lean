module

public import Mathlib.ModelTheory.Substructures
public import Section2.OminimalCuts

/-! The field-language embedding in the prescribed-lift argument. -/

public section

namespace GeneralizedEuler.Section2

open FirstOrder FirstOrder.Language

universe u v a

variable {L : Language.{u, v}} {K F : Type*} [L.Structure K] [L.Structure F]

/-- Agreement on the field formulas in two tuples induces an embedding
of the substructure generated by the first tuple. -/
theorem exists_fieldGeneratedEmbedding {Var : Type a} (x : Var → K) (y : Var → F)
    (agree : ∀ φ : L.Formula Var, φ.Realize x ↔ φ.Realize y) :
    ∃ e : Substructure.closure L (Set.range x) ↪[L] F,
      ∀ i, e ⟨x i, Substructure.subset_closure (Set.mem_range_self i)⟩ = y i := by
  classical
  let B := Substructure.closure L (Set.range x)
  let label (a : Set.range x) : Var := a.property.choose
  have hlabel (a : Set.range x) : x (label a) = a.val := a.property.choose_spec
  have named (a : B) : ∃ t : L.Term Var, t.realize x = a.val := by
    obtain ⟨t, ht⟩ := Substructure.mem_closure_iff_exists_term.mp a.property
    have hx : x ∘ label = fun a : Set.range x => a.val := funext hlabel
    exact ⟨t.relabel label, by rw [Term.realize_relabel, hx, ht]⟩
  let rep (a : B) : L.Term Var := (named a).choose
  have hrep (a : B) : (rep a).realize x = a.val := (named a).choose_spec
  let map (a : B) : F := (rep a).realize y
  have eq_terms (s t : L.Term Var) : s.realize x = t.realize x ↔ s.realize y = t.realize y := by
    simpa only [Formula.realize_equal] using agree (s.equal t)
  have onTerm (a : B) (t : L.Term Var) (ht : t.realize x = a.val) : map a = t.realize y :=
    (eq_terms (rep a) t).mp ((hrep a).trans ht.symm)
  let e : B ↪[L] F :=
    { toFun := map
      inj' := fun a b hab => Subtype.ext
        ((hrep a).symm.trans (((eq_terms (rep a) (rep b)).mpr hab).trans (hrep b)))
      map_fun' := by
        intro n f a
        apply onTerm _ (.func f (fun i => rep (a i)))
        simp only [Term.realize_func, hrep]
        exact (B.subtype.map_fun f a).symm
      map_rel' := by
        intro n r a
        have h := agree (Relations.formula r (fun i => rep (a i)))
        simp only [Formula.realize_rel, hrep] at h
        exact h.symm.trans (B.subtype.map_rel r a).symm }
  exact ⟨e, fun i => onTerm _ (.var i) rfl⟩

variable [LinearOrder K] [LinearOrder F]

/-- The uniform unary cell descriptions over the old field transport
the simple field extension along matching cuts. -/
theorem exists_simpleFieldEmbedding_of_same_cut
    (A : L.Substructure K) (e : A ↪[L] F) (a : K) (b : F)
    (hcut : ∀ c : A, ((c : K) < a ↔ e c < b) ∧ (a < (c : K) ↔ b < e c))
    (hcells : ∀ φ : L.Formula (A ⊕ Unit),
      ∃ (n : ℕ) (cells : Fin n → UnaryCellCode A),
        (φ.Realize (Sum.elim Subtype.val (fun _ => a)) ↔
          a ∈ ⋃ i, (cells i).asSet (Subtype.val : A → K)) ∧
        (φ.Realize (Sum.elim e (fun _ => b)) ↔ b ∈ ⋃ i, (cells i).asSet e)) :
    ∃ f : Substructure.closure L (Set.range (Sum.elim (Subtype.val : A → K) (fun _ : Unit => a))) ↪[L] F,
      f ⟨a, Substructure.subset_closure ⟨.inr (), rfl⟩⟩ = b ∧
      ∀ c : A, f ⟨c.val, Substructure.subset_closure ⟨.inl c, rfl⟩⟩ = e c := by
  let x : A ⊕ Unit → K := Sum.elim Subtype.val (fun _ => a)
  let y : A ⊕ Unit → F := Sum.elim e (fun _ => b)
  have agree (φ : L.Formula (A ⊕ Unit)) : φ.Realize x ↔ φ.Realize y := by
    obtain ⟨n, cells, hφx, hφy⟩ := hcells φ
    exact hφx.trans ((mem_cellUnion_iff_of_sameCut hcut cells).trans hφy.symm)
  obtain ⟨f, hf⟩ := exists_fieldGeneratedEmbedding x y agree
  exact ⟨f, hf (.inr ()), fun c => hf (.inl c)⟩

end GeneralizedEuler.Section2
