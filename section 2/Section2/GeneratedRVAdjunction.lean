module

public import Section2.CommonValuedAdjunction
public import Section2.FieldCellTransfer
public import Section2.TrivialAdjunctionRank

/-! The prescribed-representative theorem on actual generated fields.
The literature inputs concern the two T-convex restrictions and
their relative ranks. -/

public section

namespace GeneralizedEuler.Section2

open FirstOrder FirstOrder.Language

universe u v w z

variable {L : Language.{u, v}} {E : Type w} [Field E]
  {K F : Type z} [Field K] [LinearOrder K] [IsStrictOrderedRing K] [L.Structure K]
  [Field F] [LinearOrder F] [IsStrictOrderedRing F] [L.Structure F]
  {T : L.Theory} [T.IsUniversal] [K ⊨ T] [F ⊨ T]
  (terms : OrderedFieldTerms L)
  (hK : InterpretsOrderedFieldTerms (A := K) terms)
  (hF : InterpretsOrderedFieldTerms (A := F) terms)
  (O : ValuationSubring K) (Q : ValuationSubring F)
  [L.Structure (Residue O)] [L.Structure (Residue Q)]

/-- The residue structures, natural maps, and rank conclusions for
the common adjunction. The target only needs its value inputs for the
comparison of the two pulled-back rings. -/
structure OneGeneratorTConvexInputs
    {J : Type z} [Field J] [LinearOrder J] [IsStrictOrderedRing J] [L.Structure J]
    (T : L.Theory) (I I' : ValuationSubring J) (p : J →+* K) (q : J →+* F)
    (hp : RespectsValuationRing I O p)
    {graph : E → L.Formula (Fin 2)} (g : NamedFieldPowers J graph)
    (pow : NamedRVPowers I g.pow) (pow' : NamedRVPowers I' g.pow) (D : Subfield J)
    (stable : ∀ e (x : PositiveField J), (x : J) ∈ D → (g.pow e x : J) ∈ D)
    (gen : PositiveField J) where
  residueStructure : L.Structure (Residue I)
  residueModel : letI := residueStructure; Residue I ⊨ T
  sourceRank : letI := residueStructure; AdjunctionRankData g I pow D stable gen
  targetRank : RelativeValueRankLEOne I' g.pow g.zero g.one g.add g.mul D stable
    pow'.pow pow'.agrees pow'.units
  targetOldValues : I'.valuation gen.val ∈ I'.valuation '' (D : Set J) →
    ∀ x : J, I'.valuation x ∈ I'.valuation '' (D : Set J)
  sourceResidueEmbedding : letI := residueStructure
    ∃ e : Residue I ↪[L] Residue O, ∀ x, e x = mapResidue I O p hp x
  targetResidueEmbedding : letI := residueStructure
    ∀ hq : RespectsValuationRing I Q q,
      ∃ e : Residue I ↪[L] Residue Q, ∀ x, e x = mapResidue I Q q hq x

omit [LinearOrder K] [IsStrictOrderedRing K] [L.Structure K]
  [LinearOrder F] [IsStrictOrderedRing F] [L.Structure F] [T.IsUniversal] [K ⊨ T] [F ⊨ T] in
/-- Assemble the common-adjunction inputs from the natural residue
maps and the cited left and right rank statements. -/
theorem nonempty_oneGeneratorTConvexInputs_of_cited_results
    {J : Type z} [Field J] [LinearOrder J] [IsStrictOrderedRing J] [L.Structure J]
    (I I' : ValuationSubring J) [L.Structure (Residue I)] [L.Structure (Residue I')]
    [Residue I ⊨ T] (hI : IsOrderConvex I) (hI' : IsOrderConvex I')
    (p : J →+* K) (q : J →+* F) (hp : RespectsValuationRing I O p)
    {graph : E → L.Formula (Fin 2)} (g : NamedFieldPowers J graph)
    (pow : NamedRVPowers I g.pow) (pow' : NamedRVPowers I' g.pow) (D : Subfield J)
    (stable : ∀ e (x : PositiveField J), (x : J) ∈ D → (g.pow e x : J) ∈ D)
    (a : PositiveField J) (hFresh : rv I a.val ∉ rv I '' (D : Set J))
    (hFresh' : rv I' a.val ∉ rv I' '' (D : Set J))
    (left : AdjunctionRankCitations g I pow D stable a)
    (right : AdjunctionRankCitations g I' pow' D stable a)
    (hRes : ∃ e : Residue I ↪[L] Residue O, ∀ x, e x = mapResidue I O p hp x)
    (hRes' : ∀ hq : RespectsValuationRing I Q q, ∃ e : Residue I ↪[L] Residue Q,
      ∀ x, e x = mapResidue I Q q hq x) :
    Nonempty (OneGeneratorTConvexInputs O Q T I I' p q hp g pow pow' D stable a) := by
  obtain ⟨rank⟩ := left.nonempty_rankData g I pow D stable hI a hFresh
  obtain ⟨rank'⟩ := right.nonempty_rankData g I' pow' D stable hI' a hFresh'
  exact ⟨⟨inferInstance, inferInstance, rank, rank'.valueRank, rank'.oldValues, hRes, hRes'⟩⟩

/-- The substructure generated by the old field and one representative. -/
@[expose]
def adjoinFieldRepresentative (A : L.Substructure K) (a : K) : L.Substructure K :=
  Substructure.closure L (Set.range (Sum.elim (Subtype.val : A → K) (fun _ : Unit => a)))

omit [Field K] [LinearOrder K] [IsStrictOrderedRing K] in
theorem le_adjoinFieldRepresentative (A : L.Substructure K) (a : K) :
    A ≤ adjoinFieldRepresentative A a :=
  fun _ hx => Substructure.subset_closure ⟨.inl ⟨_, hx⟩, rfl⟩

omit [Field K] [LinearOrder K] [IsStrictOrderedRing K] in
theorem mem_adjoinFieldRepresentative (A : L.Substructure K) (a : K) :
    a ∈ adjoinFieldRepresentative A a :=
  Substructure.subset_closure ⟨.inr (), rfl⟩

omit [Field K] [LinearOrder K] [IsStrictOrderedRing K] [Field F] [LinearOrder F] [IsStrictOrderedRing F] in
/-- The image of a generated adjunction is the adjunction generated
by the images of the old field and the specified point. -/
theorem adjoinFieldRepresentative_range_eq (D : L.Substructure K) (k : D ↪[L] F)
    (a : K) (b : F) (f : adjoinFieldRepresentative D a ↪[L] F)
    (ha : f ⟨a, mem_adjoinFieldRepresentative D a⟩ = b)
    (hD : ∀ c : D, f ⟨c.val, le_adjoinFieldRepresentative D a c.property⟩ = k c) :
    f.toHom.range = adjoinFieldRepresentative k.toHom.range b := by
  let B := adjoinFieldRepresentative D a
  let t : D ⊕ Unit → B := Sum.elim
    (fun c => ⟨c.val, le_adjoinFieldRepresentative D a c.property⟩)
    (fun _ => ⟨a, mem_adjoinFieldRepresentative D a⟩)
  have hSource : Substructure.closure L (Set.range t) = ⊤ := by
    apply Substructure.map_injective_of_injective (f := B.subtype.toHom) B.subtype.injective
    rw [Substructure.map_closure, ← Hom.range_eq_map, ← Set.range_comp]
    have he : (B.subtype.toHom : B → K) ∘ t = Sum.elim (Subtype.val : D → K) (fun _ : Unit => a) := by
      funext i
      cases i <;> rfl
    rw [he]
    change B = B.subtype.toHom.range
    ext x
    exact ⟨fun hx => ⟨⟨x, hx⟩, rfl⟩, fun ⟨y, h⟩ => h ▸ y.property⟩
  rw [Hom.range_eq_map f.toHom, ← hSource, Substructure.map_closure, ← Set.range_comp]
  unfold adjoinFieldRepresentative
  congr 1
  ext x
  constructor
  · rintro ⟨c, rfl⟩
    cases c with
    | inl c => exact ⟨.inl ⟨k c, ⟨c, rfl⟩⟩, (hD c).symm⟩
    | inr c => exact ⟨.inr (), ha.symm⟩
  · rintro ⟨c, rfl⟩
    cases c with
    | inl c =>
      obtain ⟨d, hd⟩ := c.property
      exact ⟨.inl d, (hD d).trans hd⟩
    | inr c => exact ⟨.inr (), ha⟩

variable {graph : E → L.Formula (Fin 2)}
  (gO : NamedFieldPowers K graph) (gQ : NamedFieldPowers F graph)
  (PO : NamedRVPowers O gO.pow) (PQ : NamedRVPowers Q gQ.pow)
  (hO : IsOrderConvex O) (hQ : IsOrderConvex Q)
  {W : Set (RV0 O)}
  (A : FixedRVLift (canonicalStructure (L := L) O hO PO.pow)
    (canonicalStructure Q hQ PQ.pow) W)

set_option linter.style.haveILetI false in
/-- The external data required on the generated field of the two
prescribed representatives. -/
@[expose]
def HasOneGeneratorTConvexInputs (a : PositiveField K) (b : F) : Prop :=
  let A₀ := vfReductOfSortedSubstructure O hO PO.pow A.source
  let B := adjoinFieldRepresentative A₀ a.val
  letI := fieldOnFieldSubstructure terms hK B
  letI := strictOrderedRingOnFieldSubstructure terms hK B
  let p := ringInclusionOfFieldSubstructure terms hK B
  let hB := interpretsOrderedFieldTerms_fieldSubstructure terms hK B
  let D := (subfieldOfFieldSubstructure terms hK A₀).comap p
  let I := O.comap p
  let gen : B := ⟨a.val, mem_adjoinFieldRepresentative A₀ a.val⟩
  ∀ (f : B ↪[L] F), f gen = b →
    (∀ c : A₀, f ⟨c.val, le_adjoinFieldRepresentative A₀ a.val c.property⟩ =
      A.embedding.toEmbedding .vf c) →
    let q := ringHomOfFieldEmbedding terms hB hF f
    let I' := Q.comap q
    ∀ (aB : PositiveField B), aB.val = gen →
    ∀ (g : NamedFieldPowers B graph)
      (pow : NamedRVPowers I g.pow) (pow' : NamedRVPowers I' g.pow)
      (stable : ∀ e (x : PositiveField B), (x : B) ∈ D → (g.pow e x : B) ∈ D),
      Nonempty (OneGeneratorTConvexInputs O Q T I I' p q
        (fun _ => ValuationSubring.mem_comap.symm) g pow pow' D stable aB)

set_option linter.style.haveILetI false in
/-- From field QE and o-minimality, the prescribed representatives
produce the actual generated field. The restricted powers and the
cited residue/rank inputs then give the fixed-RV extension. -/
theorem exists_fixedRVExtension_of_generated_adjunction
    (hOM : IsOMinimalFieldTheory.{u, v, z} T) (hQE : EliminatesQuantifiers T)
    (t : A.source.carrier .rv) (ht : t.val ∉ rv O '' A.source.carrier .vf)
    (a : PositiveField K) (b : F) (ha : rv O a.val = t.val)
    (hb : rv Q b = A.embedding.toEmbedding .rv t)
    (hInput : HasOneGeneratorTConvexInputs (T := T) terms hK hF O Q gO gQ PO PQ hO hQ A a b) :
    ∃ C : FixedRVLift (canonicalStructure (L := L) O hO PO.pow)
      (canonicalStructure Q hQ PQ.pow) W, A ≤ C ∧
      C.source.carrier .vf = (adjoinFieldRepresentative
        (vfReductOfSortedSubstructure O hO PO.pow A.source) a.val : Set K) ∧
      ∃ haC : a.val ∈ C.source.carrier .vf, C.embedding.toEmbedding .vf ⟨a.val, haC⟩ = b := by
  let A₀ := vfReductOfSortedSubstructure O hO PO.pow A.source
  let B := adjoinFieldRepresentative A₀ a.val
  let gen : B := ⟨a.val, mem_adjoinFieldRepresentative A₀ a.val⟩
  have htB : ∃ f : B ↪[L] F, f gen = b ∧
      ∀ c : A₀, f ⟨c.val, le_adjoinFieldRepresentative A₀ a.val c.property⟩ =
        A.embedding.toEmbedding .vf c :=
    exists_fieldEmbedding_of_prescribed_representatives terms hK hF hOM hQE
      O Q hO hQ PO.pow PQ.pow A.source A.embedding t ht a.val b ha hb
  obtain ⟨f, hf, hOld⟩ := htB
  letI := fieldOnFieldSubstructure terms hK B
  letI := strictOrderedRingOnFieldSubstructure terms hK B
  let hB := interpretsOrderedFieldTerms_fieldSubstructure terms hK B
  let p := ringInclusionOfFieldSubstructure terms hK B
  let q := ringHomOfFieldEmbedding terms hB hF f
  let I := O.comap p
  let I' := Q.comap q
  let D₀ := A₀.comap B.subtype.toHom
  let D := (subfieldOfFieldSubstructure terms hK A₀).comap p
  let lp : B ↪ₑ[L] K := elementaryEmbeddingOfQE hQE B.subtype
  let lq : B ↪ₑ[L] F := elementaryEmbeddingOfQE hQE f
  have hp (x : B) : lp x = p x := (ringInclusionOfFieldSubstructure_apply terms hK B x).symm
  have hq (x : B) : lq x = q x := (ringHomOfFieldEmbedding_apply terms hB hF f x).symm
  have hpMono : StrictMono p := by
    intro x y h
    rw [ringInclusionOfFieldSubstructure_apply, ringInclusionOfFieldSubstructure_apply]
    exact h
  have hqMono : StrictMono q := strictMono_ringHomOfFieldEmbedding terms hB hF f
  have hpVal : RespectsValuationRing I O p := fun _ => ValuationSubring.mem_comap.symm
  have hqVal : RespectsValuationRing I' Q q := fun _ => ValuationSubring.mem_comap.symm
  have hGen : p 0 < p gen := by
    rw [map_zero, ringInclusionOfFieldSubstructure_apply]
    exact a.property
  let aB : PositiveField B := ⟨gen, hpMono.lt_iff_lt.mp hGen⟩
  obtain ⟨g⟩ := exists_namedFieldPowers_of_elementary lp p hp hpMono gO
  obtain ⟨pow⟩ := exists_namedRVPowers_of_valued_embedding lp p hp hpMono g gO I O hpVal PO
  obtain ⟨pow'⟩ := exists_namedRVPowers_of_valued_embedding lq q hq hqMono g gQ I' Q hqVal PQ
  have hD₀ (x : B) : x ∈ D₀ ↔ x ∈ D := by
    change x.val ∈ A₀ ↔ p x ∈ subfieldOfFieldSubstructure terms hK A₀
    rw [ringInclusionOfFieldSubstructure_apply, mem_subfieldOfFieldSubstructure]
  have hStable (e : E) (x : PositiveField B) (hx : (x : B) ∈ D) : (g.pow e x : B) ∈ D :=
    (hD₀ _).mp (namedFieldPowers_mem_substructure terms hB hQE g D₀ e x ((hD₀ _).mpr hx))
  obtain ⟨inputs⟩ := hInput f hf hOld aB rfl g pow pow' hStable
  letI := inputs.residueStructure
  letI := inputs.residueModel
  obtain ⟨res, hres⟩ := inputs.sourceResidueEmbedding
  let m : B := -1
  have hm : m.val = -1 := by
    rw [← ringInclusionOfFieldSubstructure_apply terms hK B m, map_neg, map_one]
  have hmD : p m ∈ subfieldOfFieldSubstructure terms hK A₀ := by
    rw [map_neg, map_one]
    exact Subfield.neg_mem _ (Subfield.one_mem _)
  have hmA : m.val ∈ A₀ :=
    (hD₀ m).mpr hmD
  let minusOne : A.source.carrier .vf := ⟨m.val, hmA⟩
  have hminus' : A.embedding.toEmbedding .vf minusOne = -1 := by
    rw [← hOld minusOne]
    change f m = -1
    rw [← ringHomOfFieldEmbedding_apply terms hB hF f m, map_neg, map_one]
  let base : A.source.carrier .vf ⊆ B := le_adjoinFieldRepresentative A₀ a.val
  have hRep : Set.range (fun c : A.source.carrier .vf => (⟨c.val, base c.property⟩ : B)) = (D : Set B) := by
    ext x
    constructor
    · rintro ⟨c, rfl⟩
      exact (hD₀ _).mp c.property
    · intro hx
      have hm : x.val ∈ A₀ := (hD₀ x).mpr hx
      exact ⟨⟨x.val, hm⟩, Subtype.ext rfl⟩
  let R := inputs.sourceRank
  let pre := R.residue
  let old : Set (Residue I) := {s | residueRV I s ∈ rv I '' (D : Set B)}
  have hb' : rv Q (lq aB.val) = A.embedding.toEmbedding .rv t := (congrArg (rv Q) hf).trans hb
  obtain ⟨C, hAC, hC, hMap⟩ :=
    exists_fixedRVExtension_of_common_valued_adjunction I I' O Q hO hQ pow.pow pow'.pow PO.pow PQ.pow
      A B f base hOld id lp lq (fun _ => rfl) (fun _ => rfl) p q hp hq hpMono hqMono hpVal hqVal
      D hRep g.pow gO.pow gQ.pow pow.agrees pow'.agrees PO.agrees PQ.agrees
      g.zero g.one g.add g.mul pow.units pow'.units hStable hQE minusOne hm hminus'
      aB t ht ha hb' R.valueRank inputs.targetRank R.oldValues inputs.targetOldValues R.oldResidues
      old (fun _ => Iff.rfl) pre.matroid pre.ground R.residueRank
      pre.nonloop pre.closure res hres inputs.targetResidueEmbedding graph g.defines gO.defines gQ.defines
      pow.offPositive PO.offPositive PQ.offPositive
  have haC : a.val ∈ C.source.carrier .vf := hC.symm ▸ gen.property
  exact ⟨C, hAC, hC, haC, (hMap gen haC).trans hf⟩

/-- The generated-field argument gives the representative step
used by the Shoenfield iteration for every fresh named RV element. -/
theorem exists_fixedRVExtension_of_tconvex_inputs
    (hOM : IsOMinimalFieldTheory.{u, v, z} T) (hQE : EliminatesQuantifiers T)
    (hInput : ∀ (a : PositiveField K) (b : F) (s : A.source.carrier .rv),
      s.val ∉ rv O '' A.source.carrier .vf →
      rv O a.val = s.val → rv Q b = A.embedding.toEmbedding .rv s →
      HasOneGeneratorTConvexInputs (T := T) terms hK hF O Q gO gQ PO PQ hO hQ A a b)
    (t : RV0 O) (ht : t ∈ W) (hFresh : t ∉ rv O '' A.source.carrier .vf) :
    ∃ C : FixedRVLift (canonicalStructure (L := L) O hO PO.pow) (canonicalStructure Q hQ PQ.pow) W,
      A ≤ C ∧ t ∈ rv O '' C.source.carrier .vf := by
  apply exists_fixedRVExtension_of_positive_representative_step O Q hO hQ PO.pow PQ.pow terms hK A _ t ht hFresh
  intro x hx hw hNew
  let a : PositiveField K := ⟨x, hx⟩
  let s : A.source.carrier .rv := ⟨rv O x, A.rv_eq.symm ▸ hw⟩
  obtain ⟨b, hb⟩ := rv_surjective Q (A.embedding.toEmbedding .rv s)
  obtain ⟨C, hAC, _, hxC, _⟩ :=
    exists_fixedRVExtension_of_generated_adjunction terms hK hF O Q gO gQ PO PQ hO hQ A
      hOM hQE s hNew a b rfl hb (hInput a b s hNew rfl hb)
  exact ⟨C, hAC, hxC⟩

end GeneralizedEuler.Section2
