module

public import Section2.SortedModelTheory

/-! The VF-generated part of a two-sorted structure and uniqueness of
embeddings on that part. -/

public section

noncomputable section

namespace GeneralizedEuler.Section2

open FirstOrder

universe u v w z z' a

variable {L : Language.{u, v}} {E : Type w} {X : TCsort → Type z}
  {Y : TCsort → Type z'} (M : SortedStructure L E X) {N : SortedStructure L E Y}

private def vfArgument (x : X .vf) : SortedArgs X [.vf] :=
  fun i => by
    have hi : i = 0 := Fin.fin_one_eq_zero (i : Fin 1)
    subst i
    exact x

/-- The leading-term symbol in an abstract sorted structure. -/
def SortedStructure.rvMap (x : X .vf) : X .rv :=
  M.funMap (.rv : FunctionSymbol L E [.vf] .rv) (vfArgument x)

theorem SortedStructure.funMap_rv (a : SortedArgs X [.vf]) :
    M.funMap .rv a = M.rvMap (a 0) := by
  unfold SortedStructure.rvMap
  congr 1
  funext i
  have hi : i = 0 := Fin.fin_one_eq_zero i
  subst i
  rfl

theorem SortedSubstructure.rvMap_mem {M : SortedStructure L E X}
    (S : SortedSubstructure M) {x : X .vf} (hx : x ∈ S.carrier .vf) :
    M.rvMap x ∈ S.carrier .rv := by
  apply S.closed .rv (vfArgument x)
  intro i
  have hi : i = 0 := Fin.fin_one_eq_zero (i : Fin 1)
  subst i
  exact hx

theorem canonicalStructure_rvMap {K : Type*} [Field K] [LinearOrder K] [IsStrictOrderedRing K]
    [L.Structure K] (O : ValuationSubring K) [L.Structure (Residue O)]
    (hO : IsOrderConvex O) (P : E → RV0 O → RV0 O) (x : K) :
    (canonicalStructure (L := L) O hO P).rvMap x = rv O x := by rfl

theorem SortedEmbedding.map_rv {M : SortedStructure L E X} (e : SortedEmbedding M N)
    (x : X .vf) :
    e.toEmbedding .rv (M.rvMap x) = N.rvMap (e.toEmbedding .vf x) := by
  unfold SortedStructure.rvMap
  rw [e.map_fun]
  congr 1
  funext i
  have hi : i = 0 := Fin.fin_one_eq_zero (i : Fin 1)
  subst i
  rfl

/-- A substructure is VF-generated if every RV element has a field
representative in that substructure. -/
@[expose]
def SortedStructure.IsVFGenerated : Prop :=
  Function.Surjective M.rvMap

/-- Agreement on VF forces agreement on both sorts for a VF-generated
substructure, including ones with trivial valuation. -/
theorem SortedEmbedding.ext_of_vf_generated (h : M.IsVFGenerated)
    (i j : SortedEmbedding M N) (hVF : ∀ x : X .vf, i.toEmbedding .vf x = j.toEmbedding .vf x) :
    ∀ s (x : X s), i.toEmbedding s x = j.toEmbedding s x := by
  intro s x
  cases s with
  | vf => exact hVF x
  | rv =>
    obtain ⟨y, rfl⟩ := h x
    rw [i.map_rv, j.map_rv, hVF]

/-- The substructure generated by a sorted tuple consists of the values of
terms in that tuple. -/
@[expose]
def SortedStructure.termGenerated {Var : TCsort → Type a} (x : ∀ s, Var s → X s) :
    SortedSubstructure M where
  carrier s := Set.range (fun t : SortedTerm L E Var s => t.realize M x)
  closed := by
    intro ss s f ys hys
    choose ts hts using hys
    exact ⟨.app f ts, congrArg (M.funMap f) (funext hts)⟩

/-- The named tuple viewed in the substructure that it generates. -/
@[expose]
def SortedStructure.termGeneratedAssignment {Var : TCsort → Type a} (x : ∀ s, Var s → X s)
    (s : TCsort) (i : Var s) : (M.termGenerated x).carrier s :=
  ⟨x s i, .intro (.var i) rfl⟩

/-- Matching quantifier-free types give an embedding of the generated
substructure carrying the first tuple to the second. -/
theorem exists_embedding_of_same_qf_type {Var : TCsort → Type a}
    (x : ∀ s, Var s → X s) (y : ∀ s, Var s → Y s)
    (hqf : ∀ φ : SortedFormula L E Var, φ.IsQF → (φ.realize M x ↔ φ.realize N y)) :
    ∃ e : SortedEmbedding (M.termGenerated x).structureOn N,
      ∀ s (i : Var s), e.toEmbedding s (M.termGeneratedAssignment x s i) = y s i := by
  classical
  let S := M.termGenerated x
  let rep (s : TCsort) (a : S.carrier s) : SortedTerm L E Var s := a.property.choose
  have hrep (s : TCsort) (a : S.carrier s) : (rep s a).realize M x = a.val :=
    a.property.choose_spec
  let F (s : TCsort) (a : S.carrier s) : Y s := (rep s a).realize N y
  have onTerm (s : TCsort) (a : S.carrier s) (t : SortedTerm L E Var s)
      (ht : t.realize M x = a.val) : F s a = t.realize N y :=
    (hqf (.equal (rep s a) t) (.equal ..)).mp ((hrep s a).trans ht.symm)
  let e : SortedEmbedding S.structureOn N :=
    { toEmbedding := fun s => ⟨F s, fun a b hab => Subtype.ext
        ((hrep s a).symm.trans (((hqf (.equal (rep s a) (rep s b)) (.equal ..)).mpr hab).trans
          (hrep s b)))⟩
      map_fun := by
        intro ss s f as
        exact onTerm s _ (.app f (fun i => rep _ (as i)))
          (congrArg (M.funMap f) (funext fun i => hrep _ (as i)))
      map_rel := by
        intro ss r as
        have hr : (fun i => (rep _ (as i)).realize M x) = fun i => (as i).val :=
          funext fun i => hrep _ (as i)
        exact (hqf (.rel r (fun i => rep _ (as i))) (.rel ..)).symm.trans
          (congrArg (M.relMap r) hr).to_iff }
  exact ⟨e, fun s i => onTerm s _ (.var i) rfl⟩

/-- An embedding of the generated substructure transports the
quantifier-free type of the generator tuple. -/
theorem same_qf_type_of_generatedEmbedding {Var : TCsort → Type a}
    (x : ∀ s, Var s → X s) (y : ∀ s, Var s → Y s)
    (e : SortedEmbedding (M.termGenerated x).structureOn N)
    (h : ∀ s i, e.toEmbedding s (M.termGeneratedAssignment x s i) = y s i)
    (φ : SortedFormula L E Var) (hφ : φ.IsQF) :
    φ.realize M x ↔ φ.realize N y := by
  let S := M.termGenerated x
  let z := M.termGeneratedAssignment x
  have hi : S.inclusion.mapAssignment z = x := by
    funext s i
    rw [SortedEmbedding.mapAssignment_apply, SortedSubstructure.inclusion_apply]
    rfl
  have he : e.mapAssignment z = y := by
    funext s i
    rw [SortedEmbedding.mapAssignment_apply]
    exact h s i
  have hM := S.inclusion.realize_qf hφ z
  have hN := e.realize_qf hφ z
  rw [hi] at hM
  rw [he] at hN
  exact hM.trans hN.symm

/-- A generated substructure is contained in any substructure
containing its generators. -/
theorem SortedStructure.termGenerated_le {Var : TCsort → Type a}
    (S : SortedSubstructure M) (x : ∀ s, Var s → S.carrier s) :
    ∀ s, (M.termGenerated (fun s j => (x s j).val)).carrier s ⊆ S.carrier s := by
  intro s p hp
  obtain ⟨t, rfl⟩ := hp
  have h := S.inclusion.realize_term x t
  have he : S.inclusion.mapAssignment x = fun s j => (x s j).val := by
    funext s j
    rw [SortedEmbedding.mapAssignment_apply, SortedSubstructure.inclusion_apply]
  rw [he, SortedSubstructure.inclusion_apply] at h
  change t.realize M (fun s j => (x s j).val) ∈ S.carrier s
  rw [← h]
  exact (t.realize S.structureOn x).property

/-- A partial embedding restricts to an isomorphism between the
substructures generated by a tuple in its domain and its image. -/
theorem exists_isomorphism_of_generated_images {Var : TCsort → Type a}
    (S : SortedSubstructure M) (e : SortedEmbedding S.structureOn N)
    (x : ∀ s, Var s → S.carrier s) :
    let U := M.termGenerated (fun s j => (x s j).val)
    let V := N.termGenerated (fun s j => e.toEmbedding s (x s j))
    ∃ f : SortedIsomorphism U.structureOn V.structureOn,
      ∀ s (y : U.carrier s),
        (f.toEmbedding s y).val = e.toEmbedding s ⟨y.val, M.termGenerated_le S x s y.property⟩ := by
  let U := M.termGenerated (fun s j => (x s j).val)
  let y := fun s j => e.toEmbedding s (x s j)
  let V := N.termGenerated y
  let hU := M.termGenerated_le S x
  have hLeft (s : TCsort) (t : SortedTerm L E Var s) :
      (t.realize S.structureOn x).val = t.realize M (fun s j => (x s j).val) := by
    have h := S.inclusion.realize_term x t
    have he : S.inclusion.mapAssignment x = fun s j => (x s j).val := by
      funext s j
      rw [SortedEmbedding.mapAssignment_apply, SortedSubstructure.inclusion_apply]
    rwa [he, SortedSubstructure.inclusion_apply] at h
  have hRight (s : TCsort) (t : SortedTerm L E Var s) :
      e.toEmbedding s (t.realize S.structureOn x) = t.realize N y := by
    have he : e.mapAssignment x = y := funext fun s => funext fun j => e.mapAssignment_apply x s j
    simpa only [he] using e.realize_term x t
  let m (s : TCsort) (p : U.carrier s) := e.toEmbedding s ⟨p.val, hU s p.property⟩
  have hEval (s : TCsort) (p : U.carrier s) (t : SortedTerm L E Var s)
      (h : t.realize M (fun s j => (x s j).val) = p.val) :
      m s p = t.realize N y := by
    change e.toEmbedding s ⟨p.val, _⟩ = _
    rw [show (⟨p.val, hU s p.property⟩ : S.carrier s) = t.realize S.structureOn x from
      Subtype.ext ((hLeft s t).trans h).symm]
    exact hRight s t
  have hMem (s : TCsort) (p : U.carrier s) : m s p ∈ V.carrier s := by
    obtain ⟨t, ht⟩ := p.property
    exact ⟨t, (hEval s p t ht).symm⟩
  let f : SortedIsomorphism U.structureOn V.structureOn :=
    { toEmbedding := fun s => ⟨fun p => ⟨m s p, hMem s p⟩,
        fun _ _ h => Subtype.ext (congrArg (fun c : S.carrier s => c.val)
          ((e.toEmbedding s).injective (congrArg Subtype.val h)))⟩
      map_fun := fun f a => Subtype.ext (e.map_fun f (fun j => ⟨(a j).val, hU _ (a j).property⟩))
      map_rel := fun r a => e.map_rel r (fun j => ⟨(a j).val, hU _ (a j).property⟩)
      surjective := by
        intro s p
        obtain ⟨t, ht⟩ := p.property
        let q : U.carrier s := ⟨_, Set.mem_range_self t⟩
        exact ⟨q, Subtype.ext ((hEval s q t rfl).trans ht)⟩ }
  exact ⟨f, fun _ _ => rfl⟩

end GeneralizedEuler.Section2
