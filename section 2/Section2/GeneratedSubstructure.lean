module

public import Section2.SortedModelTheory

/-! The VF-generated part of a two-sorted structure and uniqueness of
embeddings on that part. -/

public section

noncomputable section

namespace GeneralizedEuler.Section2

open FirstOrder

universe u v w z z' a

variable {L : Language.{u, v}} {E : Type w} {X : TCsort → Type z}
  {Y : TCsort → Type z'} (M : SortedStructure L E X) {N : SortedStructure L E Y}

private def vfArgument (x : X .vf) : SortedArgs X [.vf] :=
  fun i => by
    have hi : i = 0 := Fin.fin_one_eq_zero (i : Fin 1)
    subst i
    exact x

/-- The leading-term symbol in an abstract sorted structure. -/
def SortedStructure.rvMap (x : X .vf) : X .rv :=
  M.funMap (.rv : FunctionSymbol L E [.vf] .rv) (vfArgument x)

theorem SortedEmbedding.map_rv {M : SortedStructure L E X} (e : SortedEmbedding M N)
    (x : X .vf) :
    e.toEmbedding .rv (M.rvMap x) = N.rvMap (e.toEmbedding .vf x) := by
  unfold SortedStructure.rvMap
  rw [e.map_fun]
  congr 1
  funext i
  have hi : i = 0 := Fin.fin_one_eq_zero (i : Fin 1)
  subst i
  rfl

/-- A substructure is VF-generated if every RV element has a field
representative in that substructure. -/
def SortedStructure.IsVFGenerated : Prop :=
  Function.Surjective M.rvMap

/-- Agreement on VF forces agreement on both sorts for a VF-generated
substructure, including ones with trivial valuation. -/
theorem SortedEmbedding.ext_of_vf_generated (h : M.IsVFGenerated)
    (i j : SortedEmbedding M N) (hVF : ∀ x : X .vf, i.toEmbedding .vf x = j.toEmbedding .vf x) :
    ∀ s (x : X s), i.toEmbedding s x = j.toEmbedding s x := by
  intro s x
  cases s with
  | vf => exact hVF x
  | rv =>
    obtain ⟨y, rfl⟩ := h x
    rw [i.map_rv, j.map_rv, hVF]

/-- The substructure generated by a sorted tuple consists of the values of
terms in that tuple. -/
@[expose]
def SortedStructure.termGenerated {Var : TCsort → Type a} (x : ∀ s, Var s → X s) :
    SortedSubstructure M where
  carrier s := Set.range (fun t : SortedTerm L E Var s => t.realize M x)
  closed := by
    intro ss s f ys hys
    choose ts hts using hys
    exact ⟨.app f ts, congrArg (M.funMap f) (funext hts)⟩

/-- Matching quantifier-free types give an embedding of the generated
substructure carrying the first tuple to the second. -/
theorem exists_embedding_of_same_qf_type {Var : TCsort → Type a}
    (x : ∀ s, Var s → X s) (y : ∀ s, Var s → Y s)
    (hqf : ∀ φ : SortedFormula L E Var, φ.IsQF → (φ.realize M x ↔ φ.realize N y)) :
    ∃ e : SortedEmbedding (M.termGenerated x).structureOn N,
      ∀ s (i : Var s), e.toEmbedding s ⟨x s i, .intro (.var i) rfl⟩ = y s i := by
  classical
  let S := M.termGenerated x
  let rep (s : TCsort) (a : S.carrier s) : SortedTerm L E Var s := a.property.choose
  have hrep (s : TCsort) (a : S.carrier s) : (rep s a).realize M x = a.val :=
    a.property.choose_spec
  let F (s : TCsort) (a : S.carrier s) : Y s := (rep s a).realize N y
  have onTerm (s : TCsort) (a : S.carrier s) (t : SortedTerm L E Var s)
      (ht : t.realize M x = a.val) : F s a = t.realize N y :=
    (hqf (.equal (rep s a) t) (.equal ..)).mp ((hrep s a).trans ht.symm)
  let e : SortedEmbedding S.structureOn N :=
    { toEmbedding := fun s => ⟨F s, fun a b hab => Subtype.ext
        ((hrep s a).symm.trans (((hqf (.equal (rep s a) (rep s b)) (.equal ..)).mpr hab).trans
          (hrep s b)))⟩
      map_fun := by
        intro ss s f as
        exact onTerm s _ (.app f (fun i => rep _ (as i)))
          (congrArg (M.funMap f) (funext fun i => hrep _ (as i)))
      map_rel := by
        intro ss r as
        have hr : (fun i => (rep _ (as i)).realize M x) = fun i => (as i).val :=
          funext fun i => hrep _ (as i)
        exact (hqf (.rel r (fun i => rep _ (as i))) (.rel ..)).symm.trans
          (congrArg (M.relMap r) hr).to_iff }
  exact ⟨e, fun s i => onTerm s _ (.var i) rfl⟩

end GeneralizedEuler.Section2
