module

public import Section4.ConeBoundary
import all Section4.ConeBoundary
import all Section4.ProjectedConeRays

/-! A pointed homogeneous system is generated by finitely many extreme
rays. Normalize by the sum of the defining rows and split at the first
new tight constraint in each direction. -/
public section
noncomputable section
namespace GeneralizedEuler.Section4.Polyhedral
variable {F E I : Type*} [Field F] [LinearOrder F] [IsStrictOrderedRing F]
  [AddCommGroup E] [Module F E] [Fintype I] (a : I → E →ₗ[F] F)

abbrev Vertex := {x : E // IsVertex a x}

noncomputable instance vertexFintype : Fintype (Vertex a) := by
  classical
  exact Fintype.ofInjective (fun x : Vertex a => live (testMap a x.val))
    fun x y h => Subtype.ext (vertex_unique a x.property y.property h)

def represented {T : Type*} [Fintype T] (r : T → E) (x : E) : Prop :=
  ∃ c : T → F, (∀ i, 0≤c i) ∧ (∑ i, c i • r i) = x

theorem represented_add {T : Type*} [Fintype T] (r : T → E) {x y : E}
    (hx : represented (F := F) r x) (hy : represented (F := F) r y) : represented (F := F) r (x+y) := by
  obtain ⟨c,hc,rfl⟩ := hx
  obtain ⟨d,hd,rfl⟩ := hy
  exact ⟨fun i => c i+d i,fun i => add_nonneg (hc i) (hd i),by simp [add_smul,Finset.sum_add_distrib]⟩

theorem represented_smul {T : Type*} [Fintype T] (r : T → E) {x : E} (hx : represented (F := F) r x)
    {t : F} (ht : 0≤t) : represented (F := F) r (t • x) := by
  obtain ⟨c,hc,rfl⟩ := hx
  exact ⟨fun i => t*c i,fun i => mul_nonneg ht (hc i),by simp [mul_smul,Finset.smul_sum]⟩

variable (pointed : ∀ w, (∀ i, a i w = 0) → w=0)

include pointed in
private theorem split_normalized (u w : E) (hu : u ∈ polyCone a) (hn : totalTest a u = 1)
    (tight : ∀ i, a i u=0 → a i w=0) (balanced : totalTest a w=0) (ne : w≠0) :
    ∃ (t : F) (v : E), 0<t ∧ v = u+t • w ∧ v ∈ polyCone a ∧ totalTest a v=1 ∧
      (live (testMap a v)).card < (live (testMap a u)).card := by
  have neg : ∃ i, a i w<0 := by
    by_contra! h
    have zero := (Finset.sum_eq_zero_iff_of_nonneg (fun i _ => h i)).mp balanced
    exact ne (pointed _ (fun i => zero i (Finset.mem_univ _)))
  obtain ⟨t,ht,hv,i,pos,zero⟩ := first_boundary (testMap a u) (testMap a w) hu
    (fun i h => (tight i h).ge) neg
  let v := u+t • w
  have calcV j : a j v = a j u+t*a j w := by simp [v]
  refine ⟨t,v,ht,rfl,(fun j => (calcV j).symm ▸ hv j),?_,?_⟩
  · simp only [totalTest,calcV,Finset.sum_add_distrib,← Finset.mul_sum]
    change totalTest a u + t*totalTest a w=1
    rw [hn,balanced,mul_zero,add_zero]
  · exact live_card_drop _ _ hu (fun j h => by change a j u=0 at h; change a j v=0; rw [calcV,h,tight j h]; simp)
      ⟨i,pos,(calcV i).trans zero⟩

include pointed in
theorem normalized_representation {u : E} (hu : u ∈ polyCone a) (norm : totalTest a u=1) :
    represented (F := F) (Subtype.val : Vertex a → E) u := by
  classical
  generalize measure : (live (testMap a u)).card = n
  induction n using Nat.strong_induction_on generalizing u with
  | h n lower =>
    by_cases vertex : IsVertex a u
    · let v : Vertex a := ⟨u,vertex⟩
      refine ⟨Pi.single v 1,fun i => by by_cases h : i=v <;> simp [h],?_⟩
      rw [Finset.sum_eq_single v]
      · simp [v]
      · intro i _ h; simp [Pi.single_eq_of_ne h]
      · simp
    · have fail : ¬ ∀ w : E, (∀ i, a i u=0 → a i w=0) → totalTest a w=0 → w=0 :=
        fun h => vertex ⟨hu,norm,h⟩
      push Not at fail
      obtain ⟨w,tight,bal,ne⟩ := fail
      obtain ⟨p,_,hp,rfl,ha,na,ltA⟩ := split_normalized a pointed u w hu norm tight bal ne
      obtain ⟨q,_,hq,rfl,hb,nb,ltB⟩ := split_normalized a pointed u (-w) hu norm
        (fun i h => by simp [tight i h]) (by simpa [totalTest] using congrArg Neg.neg bal) (neg_ne_zero.mpr ne)
      have a' := lower _ (ltA.trans_eq measure) ha na rfl
      have b' := lower _ (ltB.trans_eq measure) hb nb rfl
      have lift := represented_add _ (represented_smul _ a' hq.le) (represented_smul _ b' hp.le)
      have eq : q • (u+p • w) + p • (u+q • -w) = (q+p) • u := by module
      rw [eq] at lift
      have nonzero := (add_pos hq hp).ne'
      simpa [smul_smul,nonzero] using represented_smul _ lift (inv_nonneg.mpr (add_pos hq hp).le)

include pointed in
theorem extreme_rays_generate {u : E} (hu : u ∈ polyCone a) :
    represented (F := F) (Subtype.val : Vertex a → E) u := by
  by_cases z : totalTest a u=0
  · obtain rfl := pointed u (fun i => (Finset.sum_eq_zero_iff_of_nonneg (fun j _ => hu j)).mp z i (Finset.mem_univ _))
    exact ⟨0,fun _ => le_rfl,by simp⟩
  · have pos : 0 < totalTest a u := lt_of_le_of_ne (Finset.sum_nonneg fun i _ => hu i) (Ne.symm z)
    have good : (totalTest a u)⁻¹ • u ∈ polyCone a := fun i => by simpa using mul_nonneg (inv_pos.mpr pos).le (hu i)
    have norm : totalTest a ((totalTest a u)⁻¹ • u) = 1 := by
      simp only [totalTest,map_smul,smul_eq_mul,← Finset.mul_sum]
      exact inv_mul_cancel₀ z
    simpa [smul_smul,z] using represented_smul _ (normalized_representation a pointed good norm) pos.le

end GeneralizedEuler.Section4.Polyhedral
