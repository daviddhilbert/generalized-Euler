module

public import Section4.GradedValues
public import Mathlib.Algebra.Polynomial.AlgebraMap

/-! The presentation after 4.22 for a Grothendieck ring generated by its
cells. Both Euler maps take values in polynomials, preserving ambient degree. -/
public section
noncomputable section
namespace GeneralizedEuler.Section4
open Polynomial

section NormalForms
variable {K : Type*} [CommRing K] (e H : K)

@[expose] def cellPolynomials : Set K :=
  {x | ∃ q r : Poly, x = q.eval₂ (Int.castRingHom K) e + H * r.eval₂ (Int.castRingHom K) e}

theorem cellPolynomials_subring (rel : H^2 = -(e*H)) :
    ∃ A : Subring K, A.carrier = cellPolynomials e H ∧ e ∈ A ∧ H ∈ A := by
  let ev := Polynomial.eval₂RingHom (Int.castRingHom K) e
  let A : Subring K := {
    carrier := cellPolynomials e H
    one_mem' := ⟨1,0,by simp⟩
    zero_mem' := ⟨0,0,by simp⟩
    neg_mem' := by
      rintro x ⟨q,r,rfl⟩
      refine ⟨-q,-r,?_⟩
      change -(ev q + H * ev r) = ev (-q) + H * ev (-r)
      simp [add_comm]
    add_mem' := by
      rintro x y ⟨q,r,rfl⟩ ⟨s,t,rfl⟩
      refine ⟨q+s,r+t,?_⟩
      change ev q + H*ev r + (ev s + H*ev t) = ev (q+s) + H*ev (r+t)
      rw [map_add,map_add]; ring
    mul_mem' := by
      rintro x y ⟨q,r,rfl⟩ ⟨s,t,rfl⟩
      refine ⟨q*s,q*t+r*s-X*r*t,?_⟩
      change (ev q + H*ev r)*(ev s + H*ev t) = ev (q*s) + H*ev (q*t+r*s-X*r*t)
      simp only [map_mul,map_sub,map_add]
      have hX : ev X = e := by simp [ev]
      rw [hX]; linear_combination ev r * ev t * rel }
  exact ⟨A,rfl,⟨X,0,by simp⟩,⟨0,1,by simp⟩⟩

/-- Graphs, rays, lines, bounded strips and tagged disjoint unions generate
only two polynomial coefficients. This induction starts with actual cell
scissors in the Grothendieck ring. -/
inductive CellClass : K → Prop where
  | empty : CellClass 0
  | origin : CellClass 1
  | union {a b} : CellClass a → CellClass b → CellClass (a + b)
  | graph {a} : CellClass a → CellClass (a * e)
  | ray {a} : CellClass a → CellClass (a * H)
  | line {a} : CellClass a → CellClass (a * (e + 2*H))
  | strip {a} : CellClass a → CellClass (-(a * e))

theorem all_cells_in_subring (A : Subring K) (he : e ∈ A) (hh : H ∈ A) {x}
    (h : CellClass e H x) : x ∈ A := by
  induction h with
  | empty => exact A.zero_mem
  | origin => exact A.one_mem
  | union _ _ h k => exact A.add_mem h k
  | graph _ h => exact A.mul_mem h he
  | ray _ h => exact A.mul_mem h hh
  | line _ h => exact A.mul_mem h (A.add_mem he (A.mul_mem (by simp : (2 : K) ∈ A) hh))
  | strip _ h => exact A.neg_mem (A.mul_mem h he)

variable (g b : K →+* Poly) (ge : g e = X) (be : b e = X)
  (gh : g H = -X) (bh : b H = 0)

theorem map_eval_at_value_point (f : K →+* Poly) (he : f e = X) (q : Poly) :
    f (q.eval₂ (Int.castRingHom K) e) = q := by
  induction q using Polynomial.induction_on' with
  | add q r hq hr => simp [eval₂_add,map_add,hq,hr]
  | monomial n a =>
    rw [eval₂_monomial,map_mul,map_pow,he,← C_mul_X_pow_eq_monomial]
    simp

/-- The two Euler evaluations realize the value ring as pairs of
polynomials with equal constant terms. No relation between distinct
ambient degrees is imposed by groupification. -/
@[expose] def valuePresentationOfNormal (normal : ∀ x : K, x ∈ cellPolynomials e H) :
    K ≃+* valueRing := by
  have coords (q r : Poly) :
      (g (q.eval₂ (Int.castRingHom K) e + H*r.eval₂ (Int.castRingHom K) e),
       b (q.eval₂ (Int.castRingHom K) e + H*r.eval₂ (Int.castRingHom K) e)) =
        (q-X*r,q) := by
    simp [map_add,map_mul,map_eval_at_value_point e g ge,map_eval_at_value_point e b be,gh,bh,sub_eq_add_neg]
  let f : K →+* valueRing := (g.prod b).codRestrict valueRing (by
    intro x
    obtain ⟨q,r,rfl⟩ := normal x
    rw [RingHom.prod_apply,coords]
    change (q - X*r).eval 0 = q.eval 0
    simp)
  apply RingEquiv.ofBijective f
  constructor
  · intro x y h
    obtain ⟨qx,rx,rfl⟩ := normal x
    obtain ⟨qy,ry,rfl⟩ := normal y
    have hc := congrArg Subtype.val h
    change (g _,b _) = (g _,b _) at hc
    rw [coords,coords] at hc
    obtain ⟨hv,rfl⟩ := Prod.mk.inj hc
    obtain rfl := mul_left_cancel₀ (X_ne_zero : (X : Poly) ≠ 0) (sub_right_injective hv)
    rfl
  · intro p
    obtain ⟨⟨q,r⟩,hp,_⟩ := normal_form p
    refine ⟨q.eval₂ (Int.castRingHom K) e + H*r.eval₂ (Int.castRingHom K) e,Subtype.ext ?_⟩
    change (g _,b _) = p.val
    rw [coords,hp]
    apply Prod.ext
    · change q-X*r = q+(-X)*r; ring
    · change q = q+0*r; ring

theorem valuePresentationOfNormal_apply (normal : ∀ x : K, x ∈ cellPolynomials e H) (x : K) :
    (valuePresentationOfNormal e H g b ge be gh bh normal x).val = (g x,b x) := rfl

def valuePresentation (rel : H^2 = -(e*H))
    (generated : ∀ x : K, ∃ a c, CellClass e H a ∧ CellClass e H c ∧ x = a-c) :
    K ≃+* valueRing := by
  have normal (x : K) : x ∈ cellPolynomials e H := by
    obtain ⟨A,hA,he,hh⟩ := cellPolynomials_subring e H rel
    obtain ⟨a,c,ha,hc,rfl⟩ := generated x
    rw [← hA]
    exact A.sub_mem (all_cells_in_subring e H A he hh ha) (all_cells_in_subring e H A he hh hc)
  exact valuePresentationOfNormal e H g b ge be gh bh normal

end NormalForms
end GeneralizedEuler.Section4
