/-! The finite value scalars in the concrete signed value and residue
semirings. Finite sets are counted over their original base. -/
public section
noncomputable section
namespace GeneralizedEuler.Section4
open FirstOrder GeneralizedEuler.Section2 ValueObject Polynomial
set_option backward.isDefEq.respectTransparency false
variable {F K : Type*} [Field K] [LinearOrder K] [IsStrictOrderedRing K] [Field F]
  (O : ValuationSubring K) (hO : IsOrderConvex O) {J JG JS : Language}
  [J.Structure K] [J.Structure (Residue O)] [JG.Structure O.ValueGroupˣ] [JS.Structure (SignedValueGroup O)]
  (P : F → RV0 O → RV0 O) (S : SortedSubstructure (canonicalStructure (L := J) O hO P))
  [Module F (Additive O.ValueGroupˣ)] (G : Submodule F (Additive O.ValueGroupˣ)) (A : Set (SignedValueGroup O))
local instance finiteValueAdditiveStructure : JG.Structure (Additive O.ValueGroupˣ) := inferInstanceAs (JG.Structure O.ValueGroupˣ)
local instance finiteValueSignedStructure : JS.Structure (SignTypeˣ × Additive O.ValueGroupˣ) := inferInstanceAs (JS.Structure (SignedValueGroup O))
variable (interpret : SignedInterpretation (J := JG) (H := JS) (G : Set (Additive O.ValueGroupˣ)) A)
  (defSharp : ∀ {k} {D : Set (Fin k → SignedValueGroup O)}, A.Definable JS D →
    isRVSet _ S (sharp (canonicalStructure (L := J) O hO P) (signedLabel O hO) D))
  (witness : ∀ {n} (D : Set (Fin n → RV0 O)), isRVSet _ S D → D.Nonempty → ∃ x ∈ D, ∀ i, x i ∈ S.carrier .rv)
  (base : ∀ t : S.carrier .rv, Additive.ofMul (RVValueSection.valueCoordinate t.val) ∈ G)
  (he : A.Definable JS ({1} : Set (Fin 1 → SignedValueGroup O)))
local notation "model" => canonicalStructure (L := J) O hO P
local notation "lab" => signedLabel O hO
local notation "pt" => pieceClass ({1} : Set (Fin 1 → SignedValueGroup O)) he

include interpret defSharp witness base in
theorem finite_signed_value_piece {k} (D : Set (Fin k → SignedValueGroup O)) (hd : A.Definable JS D) (fin : D.Finite) :
    pieceClass D hd = D.ncard • pt^k := by
  apply finite_value_piece_class A 1 he D hd fin
  intro E de ne
  obtain ⟨a,ha⟩ := ne
  choose t nt ht using fun i => signedLabel_rep O hO (a i)
  have eq : lab ∘ t = a := funext ht
  obtain ⟨y,⟨ny,hy⟩,old⟩ := witness _ (defSharp de) ⟨t,nt,eq ▸ ha⟩
  refine ⟨_,hy,old_signed_tuple_definable G A @interpret _ (fun i => ?_)⟩
  have vEq : (lab (y i)).2 = RVValueSection.valueCoordinate (y i) := by
    apply Units.ext
    rw [RVValueSection.coe_valueCoordinate (ny i),unsignedValue_of_signedLabel O hO _ (ny i)]
  exact vEq.symm ▸ base ⟨y i,old i⟩

include interpret defSharp witness base in
theorem finite_tagged_value_class {k} (U : Over (J := JS) A k) (fin : ∀ i, (U.piece i).Finite) :
    taggedValueClass A U = (∑ i, (U.piece i).ncard) • pt^k := by
  rw [taggedValueClass_eq_sum,Finset.sum_smul]
  exact Finset.sum_congr rfl fun i _ => finite_signed_value_piece O hO P S G A @interpret @defSharp
    @witness base he _ (U.isDefinable i) (fin i)

/-- The subsemiring generated by finite tagged objects in all degrees. -/
def finiteValueSubsemiring {V : Type*} {H : Language} [H.Structure V] (B : Set V) :
    Subsemiring (SemiringOfSets (J := H) B) :=
  Subsemiring.closure {x | ∃ (k : ℕ) (U : Over (J := H) B k), (∀ i, (U.piece i).Finite) ∧ taggedValueClass B U = x}

include interpret defSharp witness base in
theorem finite_value_polynomial_coordinates
    (ordinary : SemiringOfSets (J := JS) A →+* ℤ) (singleton : ordinary pt = 1) :
    ∃ e : Polynomial ℕ ≃+* finiteValueSubsemiring (H := JS) A, (e X).val = pt := by
  let B := finiteValueSubsemiring (H := JS) A
  have mem : pt ∈ B := Subsemiring.subset_closure
    ⟨1,single ({1} : Set (Fin 1 → SignedValueGroup O)) he,fun _ => Set.finite_singleton _,rfl⟩
  let f := eval₂RingHom (Nat.castRingHom B) (⟨pt,mem⟩ : B)
  let g := eval₂RingHom (Nat.castRingHom (SemiringOfSets (J := JS) A)) pt
  have comp : B.subtype.comp f = g := by apply Polynomial.ringHom_ext <;> simp [f,g]
  let χ := GradedEuler.polynomialMeasure _ _ (GradedEuler.value_homogeneous A) ordinary
  have xp : χ pt = X := by
    have h := GradedEuler.polynomialMeasure_X _ _ (GradedEuler.value_homogeneous A) ordinary
      ⟨1,single ({1} : Set (Fin 1 → SignedValueGroup O)) he⟩
    change χ pt = C (ordinary pt)*X^1 at h
    simpa [singleton] using h
  have neg : (signTwist.toRingHom.comp χ) pt = -X := by
    change (χ pt).comp (-X) = -X
    simp [xp]
  have inj := graded_finite_scalar_injective pt _ neg
  have onto : B ≤ g.rangeS := by
    apply Subsemiring.closure_le.mpr
    rintro _ ⟨k,U,fin,rfl⟩
    rw [finite_tagged_value_class O hO P S G A @interpret @defSharp @witness base he U fin]
    refine ⟨C (∑ i, (U.piece i).ncard) * X^k,?_⟩
    rw [map_mul,map_pow,nsmul_eq_mul]
    change (C _).eval₂ _ _ * (X.eval₂ _ _)^k = _
    rw [eval₂_C,eval₂_X]; rfl
  have surj : Function.Surjective f := by
    intro x
    obtain ⟨p,hp⟩ := onto x.property
    exact ⟨p,Subtype.ext ((DFunLike.congr_fun comp p).trans hp)⟩
  let e := RingEquiv.ofBijective f ⟨fun x y h => inj ((DFunLike.congr_fun comp x).symm.trans
    ((congrArg Subtype.val h).trans (DFunLike.congr_fun comp y))),surj⟩
  exact ⟨e,by change (B.subtype.comp f) X = _; rw [comp]; simp [g]⟩

local notation "torus" => residueClass (sharpObject model S lab {1} (defSharp he))
  (sharp_residue model S lab A defSharp {1} (Set.finite_singleton _) he)

omit [Field F] [Module F (Additive O.ValueGroupˣ)] in
theorem finite_values_into_graded_residue (ordinary : ResidueSemiring model S lab →+* ℤ)
    (unitLine : ordinary torus = -1) :
    Function.Injective (eval₂RingHom (Nat.castRingHom _) torus : Polynomial ℕ →+* ResidueSemiring model S lab) := by
  let χ := GradedEuler.polynomialMeasure _ _ (GradedEuler.residue_homogeneous model S lab) ordinary
  apply graded_finite_scalar_injective torus χ
  have eq := GradedEuler.polynomialMeasure_X _ _ (GradedEuler.residue_homogeneous model S lab) ordinary
    ⟨⟨1,sharpObject model S lab {1} (defSharp he)⟩,sharp_residue model S lab A defSharp {1} (Set.finite_singleton _) he⟩
  change χ torus = C (ordinary torus) * X^1 at eq
  simpa [unitLine] using eq

end GeneralizedEuler.Section4
